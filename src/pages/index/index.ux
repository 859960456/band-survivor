<template>
  <div class="page">
    <!-- 首页 -->
    <div if="{{phase === 'home'}}" class="screen">
      <scroll class="home-scroll" scroll-y="true">
        <div class="home-content">
        <text class="h-title">暗渊行者</text>
        <text class="h-sub">地牢走格子肉鸽</text>

        <div if="{{dailyDone}}" class="h-row h-gold" @click="claimDailyTask">
          <text class="h-row-l">领每日任务奖励</text>
          <text class="h-row-r">+10魂</text>
        </div>
        <div if="{{canClaimDaily}}" class="h-row h-gold" @click="claimDaily">
          <text class="h-row-l">每日签到</text>
          <text class="h-row-r">+8魂</text>
        </div>

        <div class="btn big-btn primary" @click="startGame">
          <text class="btn-text">开始冒险</text>
        </div>

        <div if="{{hasSave}}" class="btn big-btn" @click="continueGame">
          <text class="btn-text">继续冒险 第{{saveFloor}}层</text>
        </div>

        <div if="{{ngLevel > 0}}" class="h-row">
        <text class="h-row-l">轮回</text>
        <text class="h-row-r">NG+{{ngLevel}}</text>
      </div>
      <div if="{{ngLevel > 0 && !ngActive}}" class="btn big-btn" @click="startNGPlus">
        <text class="btn-text">进入轮回 NG+{{ngLevel}}</text>
      </div>
      <text class="h-label">难度</text>
        <div class="h-row" @click="cycleDifficulty">
          <text class="h-row-l">当前</text>
          <text class="h-row-r">{{difficultyLabel}}</text>
        </div>

        <text class="h-label">职业</text>
        <div class="h-row" @click="cycleClass">
          <text class="h-row-l">当前</text>
          <text class="h-row-r">{{classLabel}}</text>
        </div>

        <div class="h-row" @click="toggleEndless">
          <text class="h-row-l">无尽模式</text>
          <text class="h-row-r">{{endless ? '开' : '关'}}</text>
        </div>

        <div class="h-row" @click="toggleChallenge">
          <text class="h-row-l">挑战模式</text>
          <text class="h-row-r">{{challengeMode ? '开' : '关'}}</text>
        </div>

        <text class="h-label">收集</text>
        <div class="h-row" @click="openAchievements">
          <text class="h-row-l">成就</text>
          <text class="h-row-r">{{achievementCount}}/{{achievementTotal}}</text>
        </div>
        <div class="h-row" @click="openCodex">
          <text class="h-row-l">图鉴</text>
          <text class="h-row-r">{{codexCount}}/{{codexTotal}}</text>
        </div>
        <div class="h-row" @click="openMeta">
          <text class="h-row-l">永久强化</text>
          <text class="h-row-r">灵魂{{soul}}</text>
        </div>

        <text class="h-best">{{title}} · 最佳第{{best}}层</text>
      </div></scroll>
    </div>

    <!-- 地牢探索 -->
    <div if="{{phase === 'grid' || phase === 'pause'}}" class="screen grid-screen">
      <!-- 经验条：全宽顶到胶囊上缘，由设备裁剪成弧形 -->
      <div class="exp-bar">
        <div class="exp-fill" style="width: {{expPercent}}%;"></div>
      </div>
      <!-- 状态 HUD：沿顶部圆弧排布（中间高、两边低） -->
      <text class="hud-anchor hud-a0">第{{floor}}层</text>
      <text class="hud-anchor hud-a1">Lv.{{level}}</text>
      <text class="hud-anchor hud-a2">金币{{gold}}</text>
      <text class="hud-anchor hud-a3">杀{{kills}}</text>
      <div class="hud-spacer"></div>
      <!-- 血条 -->
      <div class="bar grid-bar">
        <div class="bar-fill hp-fill" style="width: {{hpPercent}}%;"></div>
      </div>
      <text class="hp-text">HP {{hp}}/{{maxHp}} · 探索{{explorePercent}}% · 武{{weaponName}}+{{weaponAtk}} · 防{{armorName}}+{{armorDef}}{{challengeMod ? ' · 词条:' : ''}}</text>
      <text class="map-msg">{{lastLog}}</text>

      <div class="map-area">
        <div class="map-container" @swipe="onMapSwipe" @touchstart="onTouchStart" @touchmove="onTouchMove" @touchend="onTouchEnd"
             style="width: {{mapViewW * 18 + 8}}px; height: {{mapViewH * 20 + 8}}px;">
          <div for="{{mapCells}}" class="cell {{$item.cls}}"
               style="left: {{$item.c * 18}}px; top: {{$item.r * 20}}px;">
            <image if="{{$item.icon}}" class="cell-icon" src="{{$item.icon}}"></image>
            <text if="{{$item.cls === 'player'}}" class="cell-text">我</text>
          </div>
        </div>
      </div>

      <text class="map-tip">滑动地图移动 · 撞怪进战斗</text>

      <!-- 底部可滚动菜单栏 -->
      <scroll class="menu-scroll" scroll-y="true">
        <div class="menu-item" @click="openBag">
          <text class="menu-label">背包</text>
          <text class="menu-sub">装备物品</text>
        </div>
        <div class="menu-item" @click="openShop">
          <text class="menu-label">商店</text>
          <text class="menu-sub">补给强化</text>
        </div>
        <div class="menu-item" @click="doRest">
          <text class="menu-label">休息</text>
          <text class="menu-sub">回复25%</text>
        </div>
        <div class="menu-item {{potions <= 0 ? 'disabled' : ''}}" @click="usePotion">
          <text class="menu-label">药水</text>
          <text class="menu-sub">剩 {{potions}}</text>
        </div>
        <div class="menu-item" @click="openPause">
          <text class="menu-label">暂停</text>
          <text class="menu-sub">菜单/设置</text>
        </div>
      </scroll>
    </div>

    <!-- 奖励 / 死亡 -->
    <div if="{{phase === 'reward'}}" class="overlay reward-overlay">
      <text class="reward-title">升级！选择强化</text>
      <div for="{{upgradeOptions}}" class="upgrade-option rarity-{{$item.rarity || 'common'}}" @click="chooseUpgrade($item.id)">
        <text class="option-name">{{$item.name}}</text>
        <text class="option-desc">{{$item.desc}}</text>
      </div>
    </div>

    <!-- 新手引导 -->
    <div if="{{phase === 'tutorial'}}" class="overlay dead-overlay">
      <text class="dead-title">新手提示</text>
      <text class="dead-text">滑动屏幕移动角色</text>
      <text class="dead-text">撞上怪物进入战斗</text>
      <text class="dead-text">击杀获得经验，升级三选一</text>
      <text class="dead-text">未探索区域被迷雾遮挡</text>
      <div class="btn" @click="closeTutorial">
        <text class="btn-text">开始冒险</text>
      </div>
    </div>

    <!-- 随机事件 -->
    <div if="{{phase === 'event'}}" class="overlay dead-overlay">
      <text class="dead-title">{{eventTitle}}</text>
      <text class="dead-text">{{eventDesc}}</text>
      <div for="{{eventOptions}}" class="btn event-btn" @click="chooseEvent($index)">
        <text class="btn-text">{{$item.label}}</text>
      </div>
    </div>

    <!-- 天赋 -->
    <div if="{{phase === 'talents'}}" class="overlay dead-overlay">
      <text class="dead-title">天赋</text>
      <text class="dead-text">可用点数：{{talentPoints}}</text>
      <scroll class="shop-scroll" scroll-y="true">
        <div for="{{talentList}}" class="ach-item {{$item.bought ? 'done' : ''}}" @click="buyTalent($item.id)">
          <text class="ach-name">{{$item.name}}</text>
          <text class="ach-desc">{{$item.desc}}</text>
        </div>
      </scroll>
      <div class="btn" @click="resetTalents">
        <text class="btn-text">重置天赋（返还点数）</text>
      </div>
      <div class="btn" @click="closeTalents">
        <text class="btn-text">关闭</text>
      </div>
    </div>

    <!-- 图鉴 -->
    <div if="{{phase === 'codex'}}" class="overlay dead-overlay">
      <text class="dead-title">怪物图鉴</text>
      <text class="dead-text">区域探索：{{visitedAreas.length}}/4</text>
      <scroll class="shop-scroll" scroll-y="true">
        <div for="{{codexList}}" class="ach-item {{$item.found ? 'done' : ''}}">
          <text class="ach-name">{{$item.name || $item.id}}</text>
          <text class="ach-desc">{{$item.found ? '已收录' : '未发现'}}</text>
        </div>
      </scroll>
      <div class="btn" @click="closeCodex">
        <text class="btn-text">关闭</text>
      </div>
    </div>

    <!-- 操作说明 -->
    <div if="{{phase === 'help'}}" class="overlay dead-overlay">
      <text class="dead-title">操作说明</text>
      <text class="dead-text">滑动屏幕移动角色</text>
      <text class="dead-text">撞上怪物进入战斗</text>
      <text class="dead-text">击杀获得经验升级，三选一强化</text>
      <text class="dead-text">未探索区域被迷雾遮挡</text>
      <text class="dead-text">精英/事件/陷阱/暗门等你探索</text>
      <div class="btn" @click="closeHelp">
        <text class="btn-text">返回</text>
      </div>
    </div>

    <!-- 永久强化 -->
    <div if="{{phase === 'meta'}}" class="overlay dead-overlay">
      <text class="dead-title">永久强化</text>
      <text class="dead-text">灵魂：{{soul}}</text>
      <div class="btn" @click="buyMetaHp">
        <text class="btn-text">生命上限 +10（{{metaUpgradeCostHp}}魂）</text>
      </div>
      <div class="btn" @click="buyMetaPotion">
        <text class="btn-text">开局药水 +1（{{metaUpgradeCostPotion}}魂）</text>
      </div>
      <div class="btn" @click="buyMetaAtk">
        <text class="btn-text">开局攻击 +2（{{metaUpgradeCostAtk}}魂）</text>
      </div>
      <div class="btn" @click="closeMeta">
        <text class="btn-text">关闭</text>
      </div>
    </div>

    <!-- 成就 -->
    <div if="{{phase === 'achievements'}}" class="overlay dead-overlay">
      <text class="dead-title">成就</text>
      <scroll class="shop-scroll" scroll-y="true">
        <div for="{{achievementList}}" class="ach-item {{$item.done ? 'done' : ''}}">
          <text class="ach-name">{{$item.name}}</text>
          <text class="ach-desc">{{$item.desc}}</text>
        </div>
      </scroll>
      <div class="btn" @click="closeAchievements">
        <text class="btn-text">关闭</text>
      </div>
    </div>

    <!-- 暂停 -->
    <div if="{{phase === 'pause'}}" class="overlay dead-overlay">
      <text class="dead-title">已暂停</text>
      <text class="dead-text">第 {{floor}} 层 · Lv.{{level}}</text>
      <div class="btn" @click="closePause">
        <text class="btn-text">继续冒险</text>
      </div>
      <div class="btn" @click="goHome">
        <text class="btn-text">返回首页</text>
      </div>
      <div class="btn" @click="endRun">
        <text class="btn-text">结束本局</text>
      </div>
      <div class="btn" @click="openTalents">
        <text class="btn-text">天赋（{{talentPoints}}点）</text>
      </div>
      <div class="btn" @click="openHelp">
        <text class="btn-text">操作说明</text>
      </div>
      <div class="btn" @click="_saveBackup">
        <text class="btn-text">备份存档</text>
      </div>
      <div class="btn" @click="_restoreBackup">
        <text class="btn-text">恢复备份</text>
      </div>
      <div class="settings">
        <div class="setting-row" @click="toggleVibrate">
          <text class="setting-label">震动</text>
          <text class="setting-value">{{vibrateOn ? '开' : '关'}}</text>
        </div>
        <div class="setting-row" @click="cycleSensitivity">
          <text class="setting-label">灵敏度</text>
          <text class="setting-value">{{sensLabel}}</text>
        </div>
      </div>
    </div>

    <div if="{{phase === 'dead'}}" class="overlay dead-overlay">
      <text class="dead-title">你倒下了</text>
      <text class="dead-text">探索到第 {{floor}} 层</text>
      <text class="dead-text">等级 Lv.{{level}} / 击杀 {{kills}}</text>
      <text class="dead-text">造成 {{_damageDealt}} 伤害 · 承受 {{_damageTaken}}</text>
      <text class="dead-text">最大连击 {{_maxCombo}} · 遗物 {{relics.length}}</text>
      <text class="dead-text">最佳记录：第 {{best}} 层</text>
      <div class="btn" @click="restart">
        <text class="btn-text">再来一局</text>
      </div>
      <div class="btn" @click="goHome">
        <text class="btn-text">返回首页</text>
      </div>
    </div>

    <!-- 商店 -->
    <div if="{{phase === 'shop'}}" class="overlay shop-overlay">
      <text class="shop-title">旅行商店</text>
      <text class="shop-gold">金币 {{gold}}</text>
      <scroll class="shop-scroll" scroll-y="true">
        <div for="{{shopItems}}" class="shop-item" @click="buyItem($item.id)">
          <text class="shop-name">{{$item.name}}</text>
          <text class="shop-desc">{{$item.desc}} · {{$item.price}}金{{$item.discount ? '（折）' : ''}}</text>
        </div>
      </scroll>
      <div class="btn shop-close {{gold < weaponUpgradeCost ? 'disabled' : ''}}" @click="upgradeWeapon">
        <text class="btn-text">强化武器（{{weaponUpgradeCost}}金）</text>
        <text class="btn-sub">当前 +{{weaponAtk}}</text>
      </div>
      <div class="btn shop-close {{gold < armorUpgradeCost ? 'disabled' : ''}}" @click="upgradeArmor">
        <text class="btn-text">强化防具（{{armorUpgradeCost}}金）</text>
        <text class="btn-sub">当前 +{{armorDef}}</text>
      </div>
      <div class="btn shop-close {{materials < 3 || gold < 20 ? 'disabled' : ''}}" @click="craftItem">
        <text class="btn-text">打造装备（3材料+20金）</text>
        <text class="btn-sub">材料 {{materials}}</text>
      </div>
      <div class="btn shop-close {{gold < 40 ? 'disabled' : ''}}" @click="gambleEquip">
        <text class="btn-text">赌装备（40金）</text>
        <text class="btn-sub">高概率高品质</text>
      </div>
      <div class="btn shop-close {{gold < 5 ? 'disabled' : ''}}" @click="refreshShop">
        <text class="btn-text">刷新商品（5金）</text>
      </div>
      <div class="btn shop-close {{materials <= 0 ? 'disabled' : ''}}" @click="sellMaterials">
        <text class="btn-text">出售材料（{{materials}}个）</text>
        <text class="btn-sub">每个 +8金</text>
      </div>
      <div class="btn shop-close" @click="closeShop">
        <text class="btn-text">离开商店</text>
      </div>
    </div>

    <!-- 背包 -->
    <div if="{{phase === 'bag'}}" class="overlay bag-overlay">
      <text class="bag-title">背包</text>
      <div class="bag-grid">
        <div class="bag-slot">
          <text class="bag-slot-label">武器</text>
          <text class="bag-slot-value">+{{weaponAtk}}</text>
          <text class="bag-slot-sub">{{weaponName}}</text>
        </div>
        <div class="bag-slot">
          <text class="bag-slot-label">防具</text>
          <text class="bag-slot-value">+{{armorDef}}</text>
          <text class="bag-slot-sub">{{armorName}}</text>
        </div>
        <div class="bag-slot">
          <text class="bag-slot-label">药水</text>
          <text class="bag-slot-value">×{{potions}}</text>
          <text class="bag-slot-sub">回复</text>
        </div>
        <div class="bag-slot">
          <text class="bag-slot-label">材料</text>
          <text class="bag-slot-value">×{{materials}}</text>
          <text class="bag-slot-sub">打造</text>
        </div>
        <div class="bag-slot">
          <text class="bag-slot-label">遗物</text>
          <text class="bag-slot-value">×{{relics.length}}</text>
          <text class="bag-slot-sub">被动</text>
        </div>
        <div class="bag-slot">
          <text class="bag-slot-label">天赋点</text>
          <text class="bag-slot-value">×{{talentPoints}}</text>
          <text class="bag-slot-sub">强化</text>
        </div>
      </div>
      <text class="bag-line">历史最佳：武+{{bestWeaponAtk}} / 防+{{bestArmorDef}} · 遗物图鉴 {{relicCodex.length}}/{{relicTotal}}</text>
      <text class="bag-line">装备图鉴 {{equipCodex.length}}/{{equipTotal}}</text>
      <text class="bag-line">金币 {{gold}} · 闪{{dodge}}% · {{skillName}}</text>
      <div class="btn" @click="usePotionFromBag">
        <text class="btn-text">使用药水</text>
      </div>
      <div class="btn" @click="closeBag">
        <text class="btn-text">关闭背包</text>
      </div>
    </div>

    <!-- 战斗界面 -->
    <div if="{{phase === 'battle'}}" class="screen">
      <div class="hud">
        <text class="hud-item">第{{floor}}层</text>
        <text class="hud-item">Lv.{{level}}</text>
        <text class="hud-item">金币{{gold}}</text>
        <text class="hud-item">杀{{kills}}</text>
      </div>
      <div class="bar">
        <div class="bar-fill hp-fill" style="width: {{hpPercent}}%;"></div>
      </div>
      <text class="hp-text">HP {{hp}}/{{maxHp}} · 连击{{combo}}</text>

      <scroll class="battle-scroll" scroll-y="true">
        <div class="monster-card">
          <text class="monster-name">{{monsterName}}</text>
          <text class="monster-hp-text">{{monsterHp}}/{{monsterMaxHp}}</text>
          <div class="bar monster-bar">
            <div class="bar-fill monster-fill" style="width: {{monsterHpPercent}}%;"></div>
          </div>
          <text class="monster-atk">攻击 {{monsterAtk}}</text>
          <text class="monster-skill" if="{{monsterSkillHint}}">技能：{{monsterSkillHint}}</text>
          <text class="monster-skill" if="{{_enemyAffixName}}" style="color:#ff5555;">词缀：{{_enemyAffixName}}</text>
        </div>

        <div class="log-box">
          <text for="{{logLines}}" class="log-line">{{$item}}</text>
        </div>
      </scroll>

      <div class="actions">
        <div class="btn action-btn" @click="doAttack">
          <text class="btn-text">攻击</text>
          <text class="btn-sub">伤害 {{atk}}</text>
        </div>
        <div class="btn action-btn {{skillCd > 0 ? 'disabled' : ''}}" @click="doSkill">
          <text class="btn-text">技能</text>
          <text class="btn-sub">{{skillCd > 0 ? 'CD ' + skillCd : skillName}}</text>
        </div>
        <div class="btn action-btn {{potions <= 0 ? 'disabled' : ''}}" @click="doHeal">
          <text class="btn-text">药水</text>
          <text class="btn-sub">×{{potions}}</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import storage from '@system.storage';
import vibrator from '@system.vibrator';
import { AREAS, MONSTERS, UPGRADES, WEAPONS, ARMORS, SHOP_ITEMS, BASE_PLAYER, SKILL_CD, HEAL_AMOUNT, RARITY_COLOR, QUALITIES, WEAPON_AFFIXES, ARMOR_AFFIXES, ACHIEVEMENTS, RELICS, TALENTS, CLASSES, CHALLENGE_MODS, RANGED_MONSTERS, AREA_LORE, ENEMY_AFFIXES } from '../../common/game-data.js';
import { computeMonsterStats, difficultyMul, randInt, areaByFloor, isBossFloor, healAmount, skillName, skillMult, moveThreshold, sensLabel, classById, bestKey, rollWeapon, rollArmor, randPick, achievementName } from '../../common/game-core.js';
import * as GameSave from '../../common/game-save.js';
import * as GameProgress from '../../common/game-progress.js';

const MAX_LOG = 6;
const BOSS_EVERY = 5;

export default {
  private: {
    phase: 'home',
    best: 0,
    difficulty: 1,
    charClass: 'warrior',
    classLabel: '战士',
    difficultyLabel: '普通',
    endless: false,
    challengeMode: false,
    hasSave: false,
    saveFloor: 0,
    saveLevel: 0,
    vibrateOn: true,
    sensitivity: 1,
    sensLabel: '中',
    unlockedAchievements: [],
    achievementCount: 0,
    achievementTotal: 0,
    achievementList: [],
    codexList: [],
    talentList: [],
    title: '初行者',
    soul: 0,
    bestWeaponAtk: 0,
    bestArmorDef: 0,
    relicCodex: [],
    relicTotal: 0,
    equipCodex: [],
    equipTotal: 0,
    canClaimDaily: false,
    metaHp: 0,
    metaPotion: 0,
    metaAtk: 0,
    eventTitle: '',
    eventDesc: '',
    eventOptions: [],
    tutorialSeen: false,
    weaponUpgradeCost: 30,
    armorUpgradeCost: 30,

    floor: 0,
    gold: 0,
    kills: 0,
    bossKills: 0,

    level: 1,
    baseAtk: 10,
    weaponAtk: 0,
    weaponName: '无',
    skillName: '重击',
    armorDef: 0,
    armorName: '无',
    atk: 10,
    critChance: 0,
    critMult: 2,
    lifesteal: 0,
    goldMul: 1,
    expMul: 1,
    skillCdMax: SKILL_CD,
    burnChance: 0,
    dodge: 0,
    combo: 0,
    _poisonTurns: 0,
    _shield: 0,
    _hasteCharges: 0,
    _damageDealt: 0,
    _comboMaxAdd: 0,
    challengeMod: '',
    ngLevel: 0,
    promoted: false,
    ngActive: false,
    ngLevel: 0,
    promoteName: '',
    dailyType: 'kill',
    dailyTarget: 5,
    dailyProgress: 0,
    dailyDone: false,
    dailyLabel: '击杀 5 个怪物',
    explorePercent: 0,
    _damageTaken: 0,
    _maxCombo: 0,
    _bossEnraged: false,
    _poisonDmg: 0,
    _burnTurns: 0,
    _burnPower: 0,
    hp: 100,
    maxHp: 100,
    hpPercent: 100,
    expPercent: 0,
    exp: 0,
    expNext: 20,

    potions: 2,

    monsterAlive: false,
    monsterName: '',
    monsterSkillHint: '',
    _portalNext: false,
    monsterHp: 0,
    monsterMaxHp: 0,
    monsterHpPercent: 0,
    monsterAtk: 0,
    monsterGold: 0,
    monsterExp: 0,
    isBoss: false,

    skillCd: 0,
    logLines: [],
    lastLog: '',
    upgradeOptions: [],
    shopItems: [],
    areaName: '',
    areaEff: '',
    codex: [],
    codexTotal: 0,
    codexCount: 0,
    visitedAreas: [],
    relics: [],
    materials: 0,
    talentPoints: 0,
    talents: [],

    mapRows: [],
    mapCells: [],
    mapViewW: 6,
    mapViewH: 10
  },

  onInit() {
    this.shopItems = SHOP_ITEMS;
    this.relicTotal = RELICS.length;
    this.equipTotal = WEAPONS.length + ARMORS.length;
    this.areaName = '';
    this.areaEff = '';
    this._width = 6;
    this._height = 10;
    this._viewW = 10;
    this._viewH = 12;
    this._camR = 0;
    this._camC = 0;
    this._touchStartX = 0;
    this._touchStartY = 0;
    this._touchMoved = false;
    this._checkDaily();
    this._initDailyTask();
    var that = this;
    storage.get({
      key: 'BAND_SURVIVOR_CHALLENGE',
      success: function(data) {
        if (data === '1') {
          that.challengeMode = true;
        }
      }
    });
    storage.get({
      key: 'BAND_SURVIVOR_CLASS',
      success: function(data) {
        if (data) {
          that.charClass = data;
          that._updateClassLabel();
        }
      }
    });
    storage.get({
      key: 'BAND_SURVIVOR_ENDLESS',
      success: function(data) {
        if (data === '1') {
          that.endless = true;
        }
      }
    });
    storage.get({
      key: 'BAND_SURVIVOR_DIFF',
      success: function(data) {
        var d = parseInt(data, 10);
        if (!isNaN(d) && d >= 0 && d <= 2) {
          that.difficulty = d;
        }
        that._updateDifficultyLabel();
        that._loadBest();
      },
      fail: function() {
        that._updateDifficultyLabel();
        that._loadBest();
      }
    });
    storage.get({
      key: 'BAND_SURVIVOR_SET',
      success: function(data) {
        try {
          var s = JSON.parse(data);
          if (s && typeof s.vibrate === 'boolean') {
            that.vibrateOn = s.vibrate;
          }
          if (s && typeof s.sensitivity === 'number') {
            that.sensitivity = s.sensitivity;
            that._updateSensLabel();
          }
        } catch (e) {}
      }
    });
    storage.get({
      key: 'BAND_SURVIVOR_META',
      success: function(data) {
        try {
          var m = JSON.parse(data);
          if (m) {
            that.soul = m.soul || 0;
            that.metaHp = m.metaHp || 0;
            that.metaPotion = m.metaPotion || 0;
            that.metaAtk = m.metaAtk || 0;
            that.bestWeaponAtk = m.bestWeaponAtk || 0;
            that.bestArmorDef = m.bestArmorDef || 0;
            that.relicCodex = m.relicCodex || [];
            that.equipCodex = m.equipCodex || [];
            that.ngLevel = m.ngLevel || 0;
          }
        } catch (e) {}
      }
    });
    storage.get({
      key: 'BAND_SURVIVOR_TUT',
      success: function(data) {
        if (data === '1') {
          that.tutorialSeen = true;
        }
      }
    });
    storage.get({
      key: 'BAND_SURVIVOR_CODEX',
      success: function(data) {
        try {
          var arr = JSON.parse(data);
          if (arr && arr.length) {
            that.codex = arr;
          }
        } catch (e) {}
        that._updateCodexCount();
      }
    });
    storage.get({
      key: 'BAND_SURVIVOR_ACH',
      success: function(data) {
        try {
          var arr = JSON.parse(data);
          if (arr && arr.length) {
            that.unlockedAchievements = arr;
          }
        } catch (e) {}
        that._updateAchievementCount();
      }
    });
    storage.get({
      key: 'BAND_SURVIVOR_SAVE',
      success: function(data) {
        try {
          var s = JSON.parse(data);
          if (s && s.grid && s.grid.length > 0) {
            that.hasSave = true;
            that.saveFloor = s.floor || 0;
            that.saveLevel = s.level || 1;
          }
        } catch (e) {}
      }
    });
  },

  startGame() {
    this._resetRun();
    this._applyChallengeMod();
    this.phase = this.tutorialSeen ? 'grid' : 'tutorial';
    this._genFloor(1);
    this._addLog('你踏入了第 1 层地牢');
    if (!this.tutorialSeen) {
      this.tutorialSeen = true;
      storage.set({ key: 'BAND_SURVIVOR_TUT', value: '1' });
    }
    this._saveRun();
  },

  restart() {
    this.startGame();
  },

  goHome() {
    this.phase = 'home';
  },

  continueGame() {
    this._continueRun();
  },

  _serializeRun() {
    return GameSave.serializeRun(this);
  },

  _saveRun() {
    GameSave.saveRun(this);
  },

  _saveBackup() {
    if (this.phase !== 'grid' || !this._grid || this._grid.length === 0) {
      return;
    }
    storage.set({
      key: 'BAND_SURVIVOR_SAVE_2',
      value: JSON.stringify(this._serializeRun())
    });
    this._addLog('已备份存档');
  },

  _restoreBackup() {
    var that = this;
    storage.get({
      key: 'BAND_SURVIVOR_SAVE_2',
      success: function(data) {
        if (!data) {
          that._addLog('暂无备份存档');
          return;
        }
        storage.set({
          key: 'BAND_SURVIVOR_SAVE',
          value: data
        });
        that._continueRun();
      }
    });
  },

  _continueRun() {
    var that = this;
    storage.get({
      key: 'BAND_SURVIVOR_SAVE',
      success: function(data) {
        var s;
        try {
          s = JSON.parse(data);
        } catch (e) {
          return;
        }
        if (!s || !s.grid || s.grid.length === 0) {
          that.hasSave = false;
          return;
        }
        that._resetRun();
        that.floor = s.floor || 1;
        that.gold = s.gold || 0;
        that.kills = s.kills || 0;
        that.level = s.level || 1;
        that.baseAtk = s.baseAtk || BASE_PLAYER.atk;
        that.weaponAtk = s.weaponAtk || 0;
        that.weaponName = s.weaponName || '无';
        that.armorDef = s.armorDef || 0;
        that.armorName = s.armorName || '无';
        that.atk = s.atk || BASE_PLAYER.atk;
        that.critChance = s.critChance || 0;
        that.critMult = s.critMult || 2;
        that.lifesteal = s.lifesteal || 0;
        that.goldMul = s.goldMul || 1;
        that.expMul = s.expMul || 1;
        that.skillCdMax = s.skillCdMax || SKILL_CD;
        that.burnChance = s.burnChance || 0;
        that.dodge = s.dodge || 0;
        that.skillName = s.skillName || that._skillName();
        that._shield = s.shield || 0;
        that._hasteCharges = s.hasteCharges || 0;
        that._comboMaxAdd = s.comboMaxAdd || 0;
        that.challengeMod = s.challengeMod || '';
        that._regen = s.regen || 0;
        that._thorns = s.thorns || 0;
        that._killHeal = s.killHeal || 0;
        that._goldSteal = s.goldSteal || 0;
        that._skillPowerAdd = s.skillPowerAdd || 0;
        that._freezeChance = s.freezeChance || 0;
        that._blockChance = s.blockChance || 0;
        that._barrier = s.barrier || 0;
        that._berserk = !!s.berserk;
        that._skillCombo = s.skillCombo || 0;
        that._revealBonus = s.revealBonus || 0;
        that._treasureBonus = s.treasureBonus || 0;
        that._floorHeal = s.floorHeal || 0;
        that._bonusDef = s.bonusDef || 0;
        that._bloodlust = s.bloodlust || 0;
        that._startHaste = s.startHaste || 0;
        that._materialBonus = s.materialBonus || 0;
        that._healBoost = s.healBoost || 0;
        that._intimidate = !!s.intimidate;
        that._resolve = !!s.resolve;
        that._stunChance = s.stunChance || 0;
        that._execute = !!s.execute;
        that._craftDiscount = s.craftDiscount || 0;
        that._cdkill = s.cdkill || 0;
        that._cleanChance = s.cleanChance || 0;
        that._openingStrike = s.openingStrike || 0;
        that._thunderChance = s.thunderChance || 0;
        that._shieldGainChance = s.shieldGainChance || 0;
        that._shieldGainAmt = s.shieldGainAmt || 0;
        that._critGold = s.critGold || 0;
        that._comboOnHit = s.comboOnHit || 0;
        that._haggle = s.haggle || 0;
        that._potionShield = s.potionShield || 0;
        that._potionCombo = s.potionCombo || 0;
        that._critCombo = s.critCombo || 0;
        that._soulOnKillChance = s.soulOnKillChance || 0;
        that._stairVision = !!s.stairVision;
        that._startCombo = s.startCombo || 0;
        that._comboHeal = s.comboHeal || 0;
        that._levelShield = s.levelShield || 0;
        that._warcry = s.warcry || 0;
        that._startShield = s.startShield || 0;
        that._fullVision = !!s.fullVision;
        that._forgeBonus = s.forgeBonus || 0;
        that._luck = s.luck || 0;
        that._shieldReflect = s.shieldReflect || 0;
        that._revive = !!s.revive;
        that._reviveUsed = !!s.reviveUsed;
        that._comboPerStack = s.comboPerStack || 0.03;
        that._levelHp = s.levelHp || 0;
        that.promoted = !!s.promoted;
        that.promoteName = s.promoteName || '';
        that.hp = s.hp || BASE_PLAYER.hp;
        that.maxHp = s.maxHp || BASE_PLAYER.maxHp;
        that.exp = s.exp || 0;
        that.expNext = s.expNext || BASE_PLAYER.expNext;
        that.potions = s.potions || BASE_PLAYER.potions;
        that._height = s.mh || 10;
        that._width = s.mw || 6;
        that._grid = s.grid || [];
        that._visited = s.visited || [];
        that.relics = s.relics || [];
        that.visitedAreas = s.visitedAreas || [];
        that.materials = s.materials || 0;
        that.talentPoints = s.talentPoints || 0;
        that.talents = s.talents || [];
        that._monsters = s.monsters || [];
        that._items = s.items || [];
        that._playerR = s.pr || 0;
        that._playerC = s.pc || 0;
        that._stairsR = s.sr || 0;
        that._stairsC = s.sc || 0;
        that._updateHp();
        that._updateExp();
        that._revealAround();
        that.phase = 'grid';
        that._renderMap();
        that._addLog('继续冒险 · 第 ' + that.floor + ' 层');
        that._saveRun();
      }
    });
  },

    _clearSave() {
    GameSave.clearSave(this);
  },

  _resetRun() {
    this.floor = 0;
    this.gold = 0;
    this.kills = 0;
    this.bossKills = 0;
    this.level = BASE_PLAYER.level;
    this.baseAtk = BASE_PLAYER.atk;
    this.weaponAtk = 0;
    this.weaponName = '无';
    this.skillName = '重击';
    this.armorDef = 0;
    this.armorName = '无';
    this.atk = BASE_PLAYER.atk;
    this.critChance = 0;
    this.critMult = 2;
    this.lifesteal = 0;
    this.goldMul = 1;
    this.expMul = 1;
    this.skillCdMax = SKILL_CD;
    this.burnChance = 0;
    this.dodge = 0;
    this.combo = 0;
    this._poisonTurns = 0;
    this._shield = 0;
    this._hasteCharges = 0;
    this._damageDealt = 0;
    this._damageTaken = 0;
    this._isElite = false;
    this._regen = 0;
    this._thorns = 0;
    this._killHeal = 0;
    this._goldSteal = 0;
    this._skillPowerAdd = 0;
    this._freezeChance = 0;
    this._blockChance = 0;
    this._barrier = 0;
    this._berserk = false;
    this._skillCombo = 0;
    this._revealBonus = 0;
    this._treasureBonus = 0;
    this._floorHeal = 0;
    this._bonusDef = 0;
    this._bloodlust = 0;
    this._startHaste = 0;
    this._materialBonus = 0;
    this._healBoost = 0;
    this._intimidate = false;
    this._resolve = false;
    this._resolveUsed = false;
    this._stunned = false;
    this._stunChance = 0;
    this._execute = false;
    this._craftDiscount = 0;
    this._cdkill = 0;
    this._cleanChance = 0;
    this._openingStrike = 0;
    this._enemyAffix = null;
    this._enemyAffixName = '';
    this._enemyDoubleAct = false;
    this._thunderChance = 0;
    this._shieldGainChance = 0;
    this._shieldGainAmt = 0;
    this._critGold = 0;
    this._comboOnHit = 0;
    this._haggle = 0;
    this._potionShield = 0;
    this._potionCombo = 0;
    this._critCombo = 0;
    this._soulOnKillChance = 0;
    this._stairVision = false;
    this._startCombo = 0;
    this._comboHeal = 0;
    this._levelShield = 0;
    this._warcry = 0;
    this._battleAtkBonus = 0;
    this._startShield = 0;
    this._fullVision = false;
    this._forgeBonus = 0;
    this._luck = 0;
    this._shieldReflect = 0;
    this._revive = false;
    this._reviveUsed = false;
    this._comboPerStack = 0.03;
    this._levelHp = 0;
    this._stunned = false;
    this.challengeMod = '';
    this.promoted = false;
    this.ngActive = this.ngLevel > 0;
    this._maxCombo = 0;
    this._comboMaxAdd = 0;
    this._bossEnraged = false;
    this._poisonDmg = 0;
    this._burnTurns = 0;
    this._burnPower = 0;
    this.hp = BASE_PLAYER.hp;
    this.maxHp = BASE_PLAYER.maxHp;
    this.hpPercent = 100;
    this.expPercent = 0;
    this.exp = BASE_PLAYER.exp;
    this.expNext = BASE_PLAYER.expNext;
    this.relics = [];
    this.visitedAreas = [];
    this.materials = 0;
    this.talentPoints = 0;
    this.talents = [];
    this.potions = BASE_PLAYER.potions;
    this.monsterAlive = false;
    this.monsterName = '';
    this.monsterId = '';
    this._portalNext = false;
    this.monsterHp = 0;
    this.monsterMaxHp = 0;
    this.monsterHpPercent = 0;
    this.monsterAtk = 0;
    this.monsterGold = 0;
    this.monsterExp = 0;
    this.isBoss = false;
    this.skillCd = 0;
    this.logLines = [];
    this.lastLog = '';
    this.upgradeOptions = [];
    this.mapRows = [];
    this.mapCells = [];
    this._grid = [];
    this._visited = [];
    this._monsters = [];
    this._items = [];
    this._playerR = 0;
    this._playerC = 0;
    this._stairsR = 0;
    this._stairsC = 0;
    this._battleMonsterR = -1;
    this._battleMonsterC = -1;
    // 应用职业与永久强化
    var cb = this._classBase();
    this.baseAtk = cb.atk + this.metaAtk;
    this.atk = this.baseAtk + this.weaponAtk;
    this.maxHp = cb.hp + this.metaHp;
    this.hp = this.maxHp;
    this.potions = cb.potions + this.metaPotion;
    this.dodge = cb.dodge;
    this.critChance = cb.crit;
    this._updateHp();
    this._updateExp();
  },

  _addLog(text) {
    var lines = this.logLines.slice(0, MAX_LOG - 1);
    lines.unshift(text);
    this.logLines = lines;
    this.lastLog = text;
  },

  _bestKey() {
    return bestKey(this.difficulty);
  },

  _loadBest() {
    var that = this;
    storage.get({
      key: this._bestKey(),
      success: function(data) {
        var n = parseInt(data, 10);
        if (!isNaN(n) && n > 0) {
          that.best = n;
        } else {
          that.best = 0;
        }
      }
    });
  },

  toggleChallenge() {
    this.challengeMode = !this.challengeMode;
    storage.set({
      key: 'BAND_SURVIVOR_CHALLENGE',
      value: this.challengeMode ? '1' : '0'
    });
  },

  toggleEndless() {
    this.endless = !this.endless;
    storage.set({
      key: 'BAND_SURVIVOR_ENDLESS',
      value: this.endless ? '1' : '0'
    });
  },

  _updateDifficultyLabel() {
    this.difficultyLabel = this.difficulty === 0 ? '简单' : (this.difficulty === 2 ? '困难' : '普通');
  },

  _updateClassLabel() {
    var names = { warrior: '战士', ranger: '游侠', mage: '法师' };
    this.classLabel = names[this.charClass] || '战士';
  },

  cycleDifficulty() {
    this.setDifficulty((this.difficulty + 1) % 3);
    this._updateDifficultyLabel();
  },

  cycleClass() {
    var ids = ['warrior', 'ranger', 'mage'];
    var idx = ids.indexOf(this.charClass);
    this.setClass(ids[(idx + 1) % ids.length]);
    this._updateClassLabel();
  },

  setDifficulty(n) {
    if (n < 0 || n > 2) {
      return;
    }
    this.difficulty = n;
    storage.set({
      key: 'BAND_SURVIVOR_DIFF',
      value: String(n)
    });
    this._loadBest();
  },

  _vibrate(duration) {
    if (!this.vibrateOn) {
      return;
    }
    try {
      vibrator.vibrate({ duration: duration || 40 });
    } catch (e) {}
  },

  _healAmount() {
    return healAmount(this.maxHp, HEAL_AMOUNT) + (this._healBoost || 0);
  },

  _updateHp() {
    this.hpPercent = Math.max(0, Math.floor(this.hp / this.maxHp * 100));
  },

  _updateExp() {
    this.expPercent = Math.max(0, Math.min(100, Math.floor(this.exp / this.expNext * 100)));
  },

  _updateMonsterHp() {
    this.monsterHpPercent = Math.max(0, Math.floor(this.monsterHp / this.monsterMaxHp * 100));
  },

  _areaByFloor(num) {
    return areaByFloor(num, AREAS, BOSS_EVERY);
  },

  _isBossFloor(num) {
    return isBossFloor(num, BOSS_EVERY);
  },

  _randomMonsterForArea() {
    var area = this._areaByFloor(this.floor);
    return randPick(area.monsters);
  },

  _difficultyMul() {
    return difficultyMul(this.difficulty, this.challengeMode);
  },

  _monsterStats(id) {
    var base = MONSTERS[id] || MONSTERS.slime;
    var area = this._areaByFloor(this.floor);
    var result = computeMonsterStats(base, this.floor, this._difficultyMul(), this.endless, area.effect);
    var ngMul = 1 + (this.ngLevel || 0) * 0.5;
    result.hp = Math.round(result.hp * ngMul);
    result.atk = Math.round(result.atk * ngMul);
    result.gold = Math.round(result.gold * ngMul);
    result.exp = Math.round(result.exp * ngMul);
    return result;
  },

  _genFloor(num) {
    this.floor = num;
    this._checkAchievements();
    this._advanceDaily(this.dailyType === 'floor' ? 1 : 0);
    if (this._barrier > 0 && num > 1) {
      this._shield += this._barrier;
    }
    if (this._floorHeal > 0 && num > 1 && this.hp < this.maxHp) {
      this.hp = Math.min(this.maxHp, this.hp + this._floorHeal);
      this._updateHp();
    }
    var sizes = [
      [6, 8],
      [7, 9],
      [8, 10],
      [9, 12],
      [10, 14],
      [12, 16],
      [13, 18],
      [14, 20]
    ];
    var idx = Math.min(Math.floor((num - 1) / 2), sizes.length - 1);
    this._height = sizes[idx][0];
    this._width = sizes[idx][1];
    this._genMap();
    if (this._stairVision && this._visited && this._visited[this._stairsR]) {
      var svR = this._stairsR, svC = this._stairsC;
      for (var sd = -1; sd <= 1; sd++) {
        for (var se = -1; se <= 1; se++) {
          var nr2 = svR + sd, nc2 = svC + se;
          if (nr2 >= 0 && nr2 < this._height && nc2 >= 0 && nc2 < this._width) {
            if (!this._visited[nr2]) { this._visited[nr2] = []; }
            this._visited[nr2][nc2] = true;
          }
        }
      }
    }
    this._renderMap();
    var area = this._areaByFloor(num);
    this.areaName = area.name;
    this.areaEff = area.effDesc || '';
    if (this.visitedAreas.indexOf(area.id) < 0) {
      this.visitedAreas.push(area.id);
    }
    var lore = AREA_LORE[area.id];
    if (lore) {
      if (this._isBossFloor(num)) {
        this._addLog('⚔ ' + lore.boss);
      } else {
        this._addLog('【' + area.name + '】' + lore.intro);
      }
    } else if (this._isBossFloor(num)) {
      this._addLog('第 ' + num + ' 层：BOSS 层！');
    } else {
      this._addLog('进入 ' + area.name + ' · 第' + this.floor + '层');
    }
    this._saveRun();
  },

  _genMap() {
    var h = this._height;
    var w = this._width;
    var grid = [];
    for (var i = 0; i < h; i++) {
      var row = [];
      for (var j = 0; j < w; j++) {
        row.push('#');
      }
      grid.push(row);
    }

    // 房间数随层数增加：前期 2 间，后期 6 间
    var roomCount = Math.min(2 + Math.floor(this.floor / 3), 6);
    var rooms = [];
    var attempts = 100;
    while (rooms.length < roomCount && attempts > 0) {
      attempts--;
      var rw = 3 + Math.floor(Math.random() * 2);
      var rh = 3 + Math.floor(Math.random() * 2);
      if (rw > w - 2) rw = w - 2;
      if (rh > h - 2) rh = h - 2;
      if (rw < 2) rw = 2;
      if (rh < 2) rh = 2;

      var maxX = w - rw - 1;
      var maxY = h - rh - 1;
      if (maxX < 1 || maxY < 1) {
        continue;
      }
      var rx = 1 + Math.floor(Math.random() * maxX);
      var ry = 1 + Math.floor(Math.random() * maxY);

      var ok = true;
      for (var k = 0; k < rooms.length; k++) {
        var r = rooms[k];
        if (rx < r.x + r.w + 1 && rx + rw + 1 > r.x &&
            ry < r.y + r.h + 1 && ry + rh + 1 > r.y) {
          ok = false;
          break;
        }
      }
      if (!ok) {
        continue;
      }
      rooms.push({ x: rx, y: ry, w: rw, h: rh });
    }

    // 保底至少两个不重叠的房间
    if (rooms.length < 2) {
      var tryX = 1;
      var tryY = 1;
      if (rooms.length === 1) {
        var only = rooms[0];
        tryX = Math.max(1, w - only.w - 3);
        tryY = Math.max(1, h - only.h - 3);
      }
      if (rooms.length === 0) {
        rooms.push({ x: 1, y: 1, w: 3, h: 3 });
      }
      if (tryX < 1) tryX = 1;
      if (tryY < 1) tryY = 1;
      rooms.push({ x: tryX, y: tryY, w: 3, h: 3 });
    }

    // 挖房间
    for (var i = 0; i < rooms.length; i++) {
      var room = rooms[i];
      for (var y = room.y; y < room.y + room.h; y++) {
        for (var x = room.x; x < room.x + room.w; x++) {
          grid[y][x] = '.';
        }
      }
    }

    // 走廊连接所有房间中心
    for (var c = 0; c < rooms.length - 1; c++) {
      var a = rooms[c];
      var b = rooms[c + 1];
      var ax = a.x + Math.floor(a.w / 2);
      var ay = a.y + Math.floor(a.h / 2);
      var bx = b.x + Math.floor(b.w / 2);
      var by = b.y + Math.floor(b.h / 2);
      var x = ax;
      var y = ay;
      while (x !== bx) {
        grid[y][x] = '.';
        x += bx > x ? 1 : -1;
      }
      while (y !== by) {
        grid[y][x] = '.';
        y += by > y ? 1 : -1;
      }
      grid[by][bx] = '.';
    }

    // 随机加一些走廊/小岔路
    for (var extra = 0; extra < roomCount; extra++) {
      var rIndex = Math.floor(Math.random() * rooms.length);
      var base = rooms[rIndex];
      var bx2 = base.x + Math.floor(base.w / 2);
      var by2 = base.y + Math.floor(base.h / 2);
      var dirX = Math.random() < 0.5 ? 1 : -1;
      var dirY = Math.random() < 0.5 ? 1 : -1;
      var lenX = 1 + Math.floor(Math.random() * 4);
      var lenY = 1 + Math.floor(Math.random() * 4);
      var x2 = bx2;
      var y2 = by2;
      for (var sx = 0; sx < lenX; sx++) {
        if (x2 + dirX < 0 || x2 + dirX >= w) {
          break;
        }
        x2 += dirX;
        grid[y2][x2] = '.';
      }
      for (var sy = 0; sy < lenY; sy++) {
        if (y2 + dirY < 0 || y2 + dirY >= h) {
          break;
        }
        y2 += dirY;
        grid[y2][x2] = '.';
      }
    }

    // 随机把少数墙标记为暗门
    var secretCount = Math.min(2 + Math.floor(this.floor / 4), 5);
    var secretPlaced = 0;
    var guard = 0;
    while (secretPlaced < secretCount && guard < 200) {
      guard++;
      var sr = Math.floor(Math.random() * h);
      var sc = Math.floor(Math.random() * w);
      if (grid[sr][sc] !== '#') {
        continue;
      }
      var adjFloor = false;
      var dirs = [[1,0],[-1,0],[0,1],[0,-1]];
      for (var di = 0; di < dirs.length; di++) {
        var ar = sr + dirs[di][0];
        var ac = sc + dirs[di][1];
        if (ar >= 0 && ar < h && ac >= 0 && ac < w && grid[ar][ac] === '.') {
          adjFloor = true;
          break;
        }
      }
      if (adjFloor) {
        grid[sr][sc] = 'S';
        secretPlaced++;
      }
    }
    this._grid = grid;
    this._visited = [];
    for (var vi = 0; vi < h; vi++) {
      var vrow = [];
      for (var vj = 0; vj < w; vj++) {
        vrow.push(false);
      }
      this._visited.push(vrow);
    }
    var first = rooms[0];
    var last = rooms[rooms.length - 1];
    // 避免出生点和楼梯同一个格子
    if (last.x === first.x && last.y === first.y) {
      last = rooms.length > 2 ? rooms[rooms.length - 2] : rooms[0];
    }
    this._playerR = first.y + Math.floor(first.h / 2);
    this._playerC = first.x + Math.floor(first.w / 2);
    this._stairsR = last.y + Math.floor(last.h / 2);
    this._stairsC = last.x + Math.floor(last.w / 2);

    this._revealAround();
    if (this._fullVision) {
      for (var fv = 0; fv < h; fv++) {
        for (var fw = 0; fw < w; fw++) {
          if (!this._visited[fv]) { this._visited[fv] = []; }
          this._visited[fv][fw] = true;
        }
      }
    }

    this._monsters = [];
    this._items = [];

    // 放怪：数量随层数增加，但每层都有解
    var monsterCount = Math.min(2 + Math.floor(this.floor / 2), 6);
    for (var m = 0; m < monsterCount; m++) {
      var mp = this._randomFloorCell(true);
      if (!mp) {
        break;
      }
      var id = this._isBossFloor(this.floor) ? this._areaByFloor(this.floor).boss : this._randomMonsterForArea();
      this._monsters.push({ id: id, row: mp.r, col: mp.c, alive: true });
    }

    // 放物品：1~3 个随机物品
    var itemCount = 1 + Math.floor(Math.random() * 3) + (this._treasureBonus || 0);
    for (var t = 0; t < itemCount; t++) {
      var ip = this._randomFloorCell(true);
      if (!ip) {
        break;
      }
      var roll = Math.random();
      var type = 'gold';
      var icon = '$';
      if (roll < 0.28) {
        type = 'potion';
        icon = '!';
      } else if (roll < 0.48) {
        type = 'weapon';
        icon = '/';
      } else if (roll < 0.62) {
        type = 'armor';
        icon = 'A';
      } else if (roll < 0.78) {
        type = 'event';
        icon = '?';
      } else if (roll < 0.90) {
        type = 'trap';
        icon = '^';
      } else if (roll < 0.92) {
        type = 'poison';
        icon = '~';
      } else if (roll < 0.95) {
        type = 'challenge';
        icon = '★';
      } else if (roll < 0.96) {
        type = 'chest';
        icon = '◈';
      } else if (roll < 0.97) {
        type = 'altar';
        icon = '▲';
      } else if (roll < 0.985) {
        type = 'rune';
        icon = '◆';
      } else if (roll < 0.99) {
        type = 'portal';
        icon = '◎';
      }
      this._items.push({ type: type, row: ip.r, col: ip.c, icon: icon });
    }

    // 保证必有一瓶药水（提高可解性）
    var hasPotion = false;
    for (var p = 0; p < this._items.length; p++) {
      if (this._items[p].type === 'potion') {
        hasPotion = true;
        break;
      }
    }
    if (!hasPotion) {
      var pp = this._randomFloorCell(true);
      if (pp) {
        this._items.push({ type: 'potion', row: pp.r, col: pp.c, icon: '!' });
      }
    }

    this._updateCamera();
  },

  _randomFloorCell(avoidPlayer) {
    var h = this._height;
    var w = this._width;
    for (var tries = 0; tries < 80; tries++) {
      var r = Math.floor(Math.random() * h);
      var c = Math.floor(Math.random() * w);
      if (this._grid[r][c] !== '.') {
        continue;
      }
      if (r === this._stairsR && c === this._stairsC) {
        continue;
      }
      if (avoidPlayer && r === this._playerR && c === this._playerC) {
        continue;
      }
      var occupied = false;
      for (var i = 0; i < this._monsters.length; i++) {
        if (this._monsters[i].row === r && this._monsters[i].col === c) {
          occupied = true;
          break;
        }
      }
      if (!occupied) {
        for (var j = 0; j < this._items.length; j++) {
          if (this._items[j].row === r && this._items[j].col === c) {
            occupied = true;
            break;
          }
        }
      }
      if (!occupied) {
        return { r: r, c: c };
      }
    }
    return null;
  },

  _updateCamera() {
    var viewH = Math.min(this._viewH, this._height);
    var viewW = Math.min(this._viewW, this._width);
    this._camR = Math.max(0, Math.min(this._playerR - Math.floor(viewH / 2), this._height - viewH));
    this._camC = Math.max(0, Math.min(this._playerC - Math.floor(viewW / 2), this._width - viewW));
  },

  _updateExplorePercent() {
    var total = 0;
    var visited = 0;
    for (var r = 0; r < this._height; r++) {
      for (var c = 0; c < this._width; c++) {
        if (this._grid[r][c] !== '#') {
          total++;
          if (this._visited && this._visited[r] && this._visited[r][c]) {
            visited++;
          }
        }
      }
    }
    this.explorePercent = total > 0 ? Math.round(visited / total * 100) : 0;
  },

  _renderMap() {
    this._updateCamera();
    var viewH = Math.min(this._viewH, this._height);
    var viewW = Math.min(this._viewW, this._width);
    this.mapViewH = viewH;
    this.mapViewW = viewW;
    var cells = [];
    for (var vr = 0; vr < viewH; vr++) {
      var r = this._camR + vr;
      for (var vc = 0; vc < viewW; vc++) {
        var c = this._camC + vc;
        var cls = this._grid[r][c] === '#' ? 'wall' : 'floor';
        if (this._grid[r][c] === 'S') {
          cls = 'secret';
        }
        var visited = this._visited && this._visited[r] && this._visited[r][c];
        if (r === this._playerR && c === this._playerC) {
          cls = 'player';
        } else if (!visited && cls === 'floor') {
          cls = 'fog';
        } else if (r === this._stairsR && c === this._stairsC) {
          cls = 'stairs';
        } else {
          if (cls === 'fog') {
            cls = 'floor';
          }
          var mon = this._monsterAt(r, c);
          if (mon) {
            cls = 'monster';
          } else {
            var item = this._itemAt(r, c);
            if (item) {
              cls = item.type;
            }
          }
        }
        var icon = '';
        if (cls === 'player') {
          icon = '';
        } else if (cls === 'fog') {
          icon = '';
        } else if (cls === 'monster') {
          icon = '/common/icons/monster.png';
        } else if (cls === 'stairs') {
          icon = '/common/icons/stairs.png';
        } else if (cls === 'gold') {
          icon = '/common/icons/gold.png';
        } else if (cls === 'potion') {
          icon = '/common/icons/potion.png';
        } else if (cls === 'weapon') {
          icon = '/common/icons/weapon.png';
        } else if (cls === 'armor') {
          icon = '/common/icons/armor.png';
        } else if (cls === 'event') {
          icon = '';
        } else if (cls === 'trap') {
          icon = '';
        } else if (cls === 'poison') {
          icon = '';
        } else if (cls === 'challenge') {
          icon = '';
        } else if (cls === 'chest') {
          icon = '';
        } else if (cls === 'altar') {
          icon = '';
        } else if (cls === 'rune') {
          icon = '';
        } else if (cls === 'portal') {
          icon = '';
        }
        cells.push({ r: vr, c: vc, cls: cls, icon: icon });
      }
    }
    this.mapCells = [];
    for (var ci = 0; ci < cells.length; ci++) {
      this.mapCells.push(cells[ci]);
    }
    this._updateExplorePercent();
  },

  _monsterAt(r, c) {
    for (var i = 0; i < this._monsters.length; i++) {
      if (this._monsters[i].alive && this._monsters[i].row === r && this._monsters[i].col === c) {
        return this._monsters[i];
      }
    }
    return null;
  },

  _itemAt(r, c) {
    for (var i = 0; i < this._items.length; i++) {
      if (this._items[i].row === r && this._items[i].col === c) {
        return this._items[i];
      }
    }
    return null;
  },

  onTouchStart(e) {
    var t = e.touches && e.touches[0];
    this._touchStartX = t ? (t.clientX != null ? t.clientX : t.pageX) : 0;
    this._touchStartY = t ? (t.clientY != null ? t.clientY : t.pageY) : 0;
    this._touchMoved = false;
  },

  onTouchMove(e) {
    if (this.phase !== 'grid') {
      return;
    }
    var touch = e.touches && e.touches[0];
    if (!touch) {
      return;
    }
    var tx = touch.clientX != null ? touch.clientX : touch.pageX;
    var ty = touch.clientY != null ? touch.clientY : touch.pageY;
    var dx = tx - this._touchStartX;
    var dy = ty - this._touchStartY;
    if (Math.abs(dx) < this._moveThreshold() && Math.abs(dy) < this._moveThreshold()) {
      return;
    }
    this._touchMoved = true;
    if (Math.abs(dx) > Math.abs(dy)) {
      this._tryMove(0, dx > 0 ? 1 : -1);
    } else {
      this._tryMove(dy > 0 ? 1 : -1, 0);
    }
    // 重置起点，方便连续滑动
    this._touchStartX = tx;
    this._touchStartY = ty;
  },

  onTouchEnd() {
    if (this._touchMoved) {
      this._touchMoved = false;
    }
  },

  onMapSwipe(e) {
    if (this.phase !== 'grid') {
      return;
    }
    var dir = e.direction;
    if (dir === 'left') {
      this._tryMove(0, -1);
    } else if (dir === 'right') {
      this._tryMove(0, 1);
    } else if (dir === 'up') {
      this._tryMove(-1, 0);
    } else if (dir === 'down') {
      this._tryMove(1, 0);
    }
  },

  _revealAround() {
    var r = this._playerR, c = this._playerC;
    var R = 2 + (this._revealBonus || 0);
    for (var dr = -R; dr <= R; dr++) {
      for (var dc = -R; dc <= R; dc++) {
        var nr = r + dr, nc = c + dc;
        if (nr >= 0 && nr < this._height && nc >= 0 && nc < this._width && this._grid[nr][nc] !== '#') {
          if (!this._visited[nr]) {
            this._visited[nr] = [];
          }
          this._visited[nr][nc] = true;
        }
      }
    }
  },

  _tryMove(dr, dc) {
    var nr = this._playerR + dr;
    var nc = this._playerC + dc;
    if (nr < 0 || nr >= this._height || nc < 0 || nc >= this._width) {
      return;
    }
    if (this._grid[nr][nc] === '#') {
      this._addLog('前方是墙');
      return;
    }
    var isSecret = this._grid[nr][nc] === 'S';
    if (isSecret) {
      this._grid[nr][nc] = '.';
      this._addLog('你发现并推开了一扇暗门！');
    }
    if (this._poisonTurns > 0) {
      if (this._cleanChance > 0 && Math.random() < this._cleanChance) {
        this._poisonTurns = 0;
        this._addLog('净化抵挡了中毒！');
      } else {
        this._poisonTurns--;
        this.hp -= this._poisonDmg;
        this._updateHp();
        this._addLog('中毒发作，受到 ' + this._poisonDmg + ' 伤害');
        if (this.hp <= 0) {
          this.hp = 0;
          this._updateHp();
          this._die();
          return;
        }
      }
    }
    if (this._regen > 0 && this.hp < this.maxHp) {
      this.hp = Math.min(this.maxHp, this.hp + this._regen);
      this._updateHp();
    }

    // 楼梯
    if (nr === this._stairsR && nc === this._stairsC) {
      this._genFloor(this.floor + 1);
      return;
    }

    var mon = this._monsterAt(nr, nc);
    if (mon) {
      this._startBattle(mon);
      return;
    }

    var item = this._itemAt(nr, nc);
    if (item) {
      this._playerR = nr;
      this._playerC = nc;
      this._pickItem(item);
      this._removeItem(item);
      if (this._portalNext) {
        this._portalNext = false;
        this._genFloor(this.floor + 1);
        return;
      }
      if (this.phase !== 'grid') {
        return;
      }
      this._revealAround();
      this._renderMap();
      if (this._hasteCharges > 0) {
        this._hasteCharges--;
        this._addLog('迅捷：本回合怪物未行动');
      } else {
        this._monstersTurn();
      }
      this._afterMonstersTurn();
      return;
    }

    this._playerR = nr;
    this._playerC = nc;
    this._revealAround();
    this._renderMap();
    if (this._hasteCharges > 0) {
      this._hasteCharges--;
      this._addLog('迅捷：本回合怪物未行动');
    } else {
      this._monstersTurn();
    }
    this._afterMonstersTurn();
  },

  _rollWeapon() {
    var w = rollWeapon(WEAPONS, QUALITIES, WEAPON_AFFIXES, this.floor + (this._luck || 0));
    this._recordEquip(w.baseName);
    return w;
  },

  _rollArmor() {
    var a = rollArmor(ARMORS, QUALITIES, ARMOR_AFFIXES, this.floor + (this._luck || 0));
    this._recordEquip(a.baseName);
    return a;
  },

  _pickItem(item) {
    this._vibrate(30);
    if (item.type === 'gold') {
      var gold = 5 + Math.floor(Math.random() * 10);
      this.gold += gold;
      this._addLog('拾取 ' + gold + ' 金币');
    } else if (item.type === 'potion') {
      this.potions += 1;
      this._addLog('拾取药水，现有 ' + this.potions + ' 瓶');
    } else if (item.type === 'weapon') {
      var weapon = this._rollWeapon();
      if (weapon.atk > this.weaponAtk) {
        this.weaponAtk = weapon.atk;
        this.weaponName = weapon.name;
        this.atk = this.baseAtk + this.weaponAtk;
        this.skillName = this._skillName();
        this._addLog('获得武器 ' + weapon.name + '，攻击 +' + weapon.atk);
      } else {
        this._addLog('获得 ' + weapon.name + '，但不如当前武器');
      }
    } else if (item.type === 'challenge') {
      this._startChallenge();
    } else if (item.type === 'portal') {
      this._portalNext = true;
      this._addLog('进入传送门，即将跃升一层');
    } else if (item.type === 'rune') {
      this.talentPoints += 1;
      this._addLog('参悟符文，天赋点 +1');
    } else if (item.type === 'altar') {
      var ar = Math.random();
      if (ar < 0.3) {
        this.baseAtk += 2;
        this.atk = this.baseAtk + this.weaponAtk;
        this._addLog('祭坛祝福：攻击 +2');
      } else if (ar < 0.6) {
        this.maxHp += 10;
        this.hp = Math.min(this.maxHp, this.hp + 10);
        this._updateHp();
        this._addLog('祭坛祝福：生命上限 +10');
      } else if (ar < 0.85) {
        this.critChance += 0.03;
        this._addLog('祭坛祝福：暴击 +3%');
      } else {
        this.goldMul += 0.05;
        this._addLog('祭坛祝福：金币获取 +5%');
      }
    } else if (item.type === 'chest') {
      var cr = Math.random();
      this._vibrate(60);
      if (cr < 0.4) {
        this.gold += 30;
        this._addLog('宝箱开启：30 金币');
      } else if (cr < 0.7) {
        this.potions += 1;
        this._addLog('宝箱开启：药水 +1');
      } else if (cr < 0.9) {
        this._equipRolled(this._rollWeapon());
      } else {
        this._equipRolledArmor(this._rollArmor());
      }
    } else if (item.type === 'poison') {
      this._poisonTurns = 3;
      this._poisonDmg = Math.max(2, Math.round(3 + this.floor * 0.5));
      this._addLog('踩中毒沼，陷入中毒（每步 -' + this._poisonDmg + '）');
    } else if (item.type === 'trap') {
      var tdmg = Math.max(3, Math.round(6 + this.floor * 0.6));
      this.hp -= tdmg;
      this._updateHp();
      this._vibrate(60);
      this._addLog('踩中陷阱，受到 ' + tdmg + ' 伤害');
      if (this.hp <= 0) {
        this.hp = 0;
        this._updateHp();
        this._die();
      }
    } else if (item.type === 'event') {
      this._openEvent();
    } else if (item.type === 'armor') {
      var armor = this._rollArmor();
      if (armor.def > this.armorDef) {
        this.armorDef = armor.def;
        this.armorName = armor.name;
        this.dodge = armor.dodge || 0;
        this._addLog('获得防具 ' + armor.name + '，防御 +' + armor.def);
      } else {
        this._addLog('获得 ' + armor.name + '，但不如当前防具');
      }
    }
  },

  _removeItem(item) {
    var idx = -1;
    for (var i = 0; i < this._items.length; i++) {
      if (this._items[i].row === item.row && this._items[i].col === item.col) {
        idx = i;
        break;
      }
    }
    if (idx >= 0) {
      this._items.splice(idx, 1);
    }
  },

  _startChallenge() {
    var area = this._areaByFloor(this.floor);
    var list = area.monsters;
    var id = list[Math.floor(Math.random() * list.length)];
    var base = this._monsterStats(id);
    var elite = {
      name: '精英·' + base.name,
      hp: Math.round(base.hp * 2.2),
      atk: Math.round(base.atk * 1.8),
      gold: Math.round(base.gold * 3),
      exp: Math.round(base.exp * 2.5)
    };
    this.monsterAlive = true;
    this.monsterId = id;
    this.monsterName = elite.name;
    this.monsterSkillHint = this._monsterSkillHint(id);
    this.monsterMaxHp = elite.hp;
    this.monsterHp = elite.hp;
    this.monsterHpPercent = 100;
    this.monsterAtk = elite.atk;
    this.monsterGold = elite.gold;
    this.monsterExp = elite.exp;
    this.isBoss = false;
    this.skillCd = 0;
    this.combo = 0;
    this._isElite = true;
    var ea = ENEMY_AFFIXES[Math.floor(Math.random() * ENEMY_AFFIXES.length)];
    this._enemyAffix = ea;
    this._enemyAffixName = ea.name;
    if (ea.stat === 'atkMul') {
      elite.atk = Math.round(elite.atk * ea.value);
    }
    this.phase = 'battle';
    this._addLog('遭遇精英 ' + elite.name + ' [' + ea.name + ']');
  },

  _startBattle(mon) {
    this._battleMonsterR = mon.row;
    this._battleMonsterC = mon.col;
    this._spawnMonster(mon.id, false);
  },

  _spawnMonster(monsterId, isBoss) {
    var stats = this._monsterStats(monsterId);
    this.monsterId = monsterId;
    this.monsterAlive = true;
    this.monsterName = stats.name;
    this.monsterSkillHint = this._monsterSkillHint(monsterId);
    this.monsterMaxHp = stats.hp;
    this.monsterHp = stats.hp;
    this.monsterHpPercent = 100;
    this.monsterAtk = stats.atk;
    this.monsterGold = stats.gold;
    this.monsterExp = stats.exp;
    this.isBoss = isBoss;
    this.skillCd = 0;
    this._battleAtkBonus = this._warcry || 0;
    if (this._startShield > 0) {
      this._shield += this._startShield;
    }
    this.combo = this._startCombo || 0;
    this._isElite = false;
    this._bossEnraged = false;
    this._resolveUsed = false;
    if (this._startHaste > 0) {
      this._hasteCharges += this._startHaste;
    }
    if (this._intimidate) {
      this.monsterAtk = Math.max(1, Math.round(this.monsterAtk * 0.8));
    }
    if (this._openingStrike > 0) {
      this.monsterHp -= this._openingStrike;
      this._updateMonsterHp();
      this._addLog('先机打击！造成 ' + this._openingStrike + ' 伤害');
      if (this.monsterHp <= 0) {
        this.monsterHp = 0;
        this._updateMonsterHp();
        this.monsterAlive = false;
        this.phase = 'battle';
        this._addLog('遭遇 ' + stats.name + '（先手击杀！）');
        this._onMonsterDead();
        return;
      }
    }
    this.phase = 'battle';
    if (isBoss && !this._enemyAffix) {
      this._enemyAffix = ENEMY_AFFIXES[Math.floor(Math.random() * ENEMY_AFFIXES.length)];
      this._enemyAffixName = this._enemyAffix.name;
      this._addLog('[' + this._enemyAffix.name + '] ' + stats.name);
    }
    if (isBoss) {
      var bossArea = this._areaByFloor(this.floor);
      var bossLore = AREA_LORE[bossArea.id];
      if (bossLore && bossLore.boss) {
        this._addLog(bossLore.boss);
      }
    }
    this._addLog('遭遇 ' + stats.name);
  },

  doAttack() {
    if (this.phase !== 'battle' || !this.monsterAlive) {
      return;
    }
    this._playerAction(1);
  },

  _monsterSkillHint(id) {
    var map = { spider: '毒液', demon: '吸血', orc: '狂暴', wolf: '突袭', bat: '吸血', goblin: '偷金', yeti: '寒伤', fire_imp: '灼伤', lava_golem: '灼伤', inferno_lord: '灼伤', frost_king: '冰甲', cave_rat: '撕咬', magma_spider: '灼伤', void_walker: '虚空', cursed_knight: '诅咒', treant: '缠绕', frost_wolf: '寒咬' };
    return map[id] || '';
  },

  _skillName() {
    if (this.promoted && this.promoteName) {
      var cls = this._classBase();
      if (cls && cls.skillBonus) {
        return cls.skillBonus;
      }
    }
    return skillName(this.weaponAtk);
  },

  _skillMult() {
    var base = skillMult(this.weaponAtk) + this._skillPowerAdd;
    if (this.promoted) {
      if (this.charClass === 'warrior') base *= 1.3;
      else if (this.charClass === 'ranger') base *= 1.5;
      else if (this.charClass === 'mage') base *= 1.8;
    }
    return base;
  },

  doSkill() {
    if (this.phase !== 'battle' || !this.monsterAlive) {
      return;
    }
    if (this.skillCd > 0) {
      return;
    }
    this.skillCd = this.skillCdMax;
    this._addLog('释放 ' + this._skillName());
    if (this._skillCombo > 0) {
      this.combo += this._skillCombo;
    }
    this._playerAction(this._skillMult());
  },

  doHeal() {
    if (this.phase !== 'battle' || !this.monsterAlive) {
      return;
    }
    if (this.potions <= 0 || this.hp >= this.maxHp) {
      this._addLog('药水无效');
      return;
    }
    this.potions -= 1;
    var healAmt = this._healAmount();
    this.hp = Math.min(this.maxHp, this.hp + healAmt);
    if (this._potionShield > 0) {
      this._shield += this._potionShield;
    }
    if (this._potionCombo > 0) {
      this.combo += this._potionCombo;
    }
    this._updateHp();
    this._addLog('使用药水，回复 ' + healAmt + ' 生命' + (this._potionShield > 0 ? '，获得护盾' : ''));
    this._monsterAttack();
  },

  _playerAction(multiplier) {
    if (this._burnTurns > 0) {
      this.monsterHp -= this._burnPower;
      this._updateMonsterHp();
      this._addLog('灼烧造成 ' + this._burnPower + ' 伤害');
      this._burnTurns--;
      if (this.monsterHp <= 0) {
        this.monsterHp = 0;
        this._updateMonsterHp();
        this.monsterAlive = false;
        this._onMonsterDead();
        return;
      }
    }
    if (!this._burnTurns && this.burnChance > 0 && Math.random() < this.burnChance) {
      this._burnTurns = 3;
      this._burnPower = Math.max(2, Math.round(this.atk * 0.25));
      this._addLog('怪物被点燃了');
    }
    this.combo += 1;
    this._maxCombo = Math.max(this._maxCombo, this.combo);
    if (this.combo === 5 || this.combo === 10 || this.combo === 15) {
      this._vibrate(200);
      this._addLog('连击 x' + this.combo + '！');
      if (this._comboHeal > 0 && this.hp < this.maxHp) {
        this.hp = Math.min(this.maxHp, this.hp + this._comboHeal);
        this._updateHp();
      }
    }
    var comboBonus = 1 + Math.min(this.combo * this._comboPerStack, 0.6 + this._comboMaxAdd);
    var isCrit = Math.random() < this.critChance;
    var effectiveAtk = this.atk + this._bloodlust - 1 + (this._battleAtkBonus || 0);
    var dmg = Math.max(1, Math.round(effectiveAtk * multiplier * comboBonus * (0.9 + Math.random() * 0.2) * (isCrit ? this.critMult : 1)));
    if (this._berserk && this.maxHp > 0) {
      var missing = 1 - this.hp / this.maxHp;
      dmg = Math.max(1, Math.round(dmg * (1 + missing * 0.3)));
    }
    if (this._execute && this.monsterHp < this.monsterMaxHp * 0.3) {
      dmg = Math.max(1, Math.round(dmg * 1.5));
    }
    this._damageDealt += dmg;
    if (this._thunderChance > 0 && Math.random() < this._thunderChance && this.monsterAlive) {
      var thunderDmg = Math.max(1, Math.round(dmg * 0.4));
      this.monsterHp -= thunderDmg;
      this._updateMonsterHp();
      this._addLog('雷霆追加 ' + thunderDmg + ' 伤害');
      if (this.monsterHp <= 0) {
        this.monsterHp = 0;
        this._updateMonsterHp();
        this.monsterAlive = false;
        this._onMonsterDead();
        return;
      }
    }
    this.monsterHp -= dmg;
    this._updateMonsterHp();
    if (isCrit) {
      this._addLog('你造成 ' + dmg + ' 点暴击伤害！');
      if (this._critGold > 0) {
        this.gold += this._critGold;
      }
      if (this._critCombo > 0) {
        this.combo += this._critCombo;
      }
    } else {
      this._addLog('你造成 ' + dmg + ' 点伤害');
    }
    if (this._freezeChance > 0 && Math.random() < this._freezeChance) {
      this.monsterAtk = Math.max(1, Math.round(this.monsterAtk * 0.8));
      this._addLog('冰冻削弱了怪物攻击！');
    }
    if (this._stunChance > 0 && Math.random() < this._stunChance) {
      this._stunned = true;
      this._addLog('怪物被电击眩晕了！');
    }
    if (this.lifesteal > 0) {
      var heal = Math.min(this.maxHp - this.hp, this.lifesteal);
      if (heal > 0) {
        this.hp += heal;
        this._updateHp();
      }
    }

    if (this.monsterHp <= 0) {
      this.monsterHp = 0;
      this._updateMonsterHp();
      this.monsterAlive = false;
      this._onMonsterDead();
      return;
    }

    this._monsterAttack();
  },

  _monsterAttack() {
    if (this._stunned) {
      this._stunned = false;
      this._addLog('怪物眩晕中，无法行动');
      return;
    }
    if (this.isBoss && !this._bossEnraged && this.monsterHp < this.monsterMaxHp * 0.5) {
      this._bossEnraged = true;
      this._addLog(this.monsterName + ' 狂暴了！攻击大幅提升');
      this.monsterAtk = Math.round(this.monsterAtk * 1.4);
    }
    if (this.dodge > 0 && Math.random() * 100 < this.dodge) {
      this._addLog('你闪避了 ' + this.monsterName + ' 的攻击');
      return;
    }
    var dmg = Math.max(1, Math.round((this.monsterAtk - this.armorDef - this._bonusDef) * (0.85 + Math.random() * 0.3)));
    var blocked = false;
    if (this._blockChance > 0 && Math.random() < this._blockChance) {
      dmg = Math.max(1, Math.round(dmg * 0.5));
      blocked = true;
      this._addLog('你格挡了部分伤害');
    }
    var absorbed = Math.min(this._shield, dmg);
    this._shield -= absorbed;
    if (absorbed > 0 && this._shieldReflect > 0 && this.monsterAlive) {
      var reflectDmg = Math.max(1, Math.round(absorbed * this._shieldReflect));
      this.monsterHp -= reflectDmg;
      this._updateMonsterHp();
      this._addLog('护盾反弹 ' + reflectDmg + ' 伤害');
      if (this.monsterHp <= 0) {
        this.monsterHp = 0;
        this._updateMonsterHp();
        this.monsterAlive = false;
        this._onMonsterDead();
        return;
      }
    }
    dmg -= absorbed;
    this.hp -= dmg;
    this._damageTaken += dmg;
    this._updateHp();
    this._vibrate(60);
    this._addLog(this.monsterName + ' 反击 ' + dmg + ' 伤害' + (absorbed > 0 ? '（护盾吸收 ' + absorbed + '）' : ''));
    if (this._comboOnHit > 0 && Math.random() < this._comboOnHit) {
      this.combo += 1;
    }
    if (this._shieldGainChance > 0 && Math.random() < this._shieldGainChance) {
      this._shield += this._shieldGainAmt;
      this._addLog('守护获得护盾 +' + this._shieldGainAmt);
    }
    if (this._resolve && !this._resolveUsed && this.hp > 0 && this.hp < this.maxHp * 0.3) {
      this.hp = Math.min(this.maxHp, this.hp + 20);
      this._resolveUsed = true;
      this._updateHp();
      this._addLog('坚毅复苏！回复 20 生命');
    }

    if (this._thorns > 0 && this.monsterAlive) {
      this.monsterHp -= this._thorns;
      this._updateMonsterHp();
      this._addLog('荆棘反伤 ' + this._thorns);
      if (this.monsterHp <= 0) {
        this.monsterHp = 0;
        this._updateMonsterHp();
        this.monsterAlive = false;
        this._onMonsterDead();
        return;
      }
    }

    // 敌人词缀效果
    var ea = this._enemyAffix;
    if (ea) {
      if (ea.stat === 'vampiric' || ea.stat === 'lifesteal') {
        var heal = Math.max(1, Math.round(dmg * ea.value));
        this.monsterHp = Math.min(this.monsterMaxHp, this.monsterHp + heal);
        this._updateMonsterHp();
        this._addLog(ea.name + '回复 ' + heal);
      }
      if (ea.stat === 'thorny' || ea.stat === 'reflect') {
        var refl = Math.max(1, Math.round(ea.value));
        this.hp -= refl;
        this._updateHp();
        this._addLog('荆棘反伤 ' + refl);
      }
      if (ea.stat === 'lowHpAtk' && this.monsterHp < this.monsterMaxHp * 0.5) {
        var bonusDmg = Math.max(1, Math.round(dmg * (ea.value - 1)));
        this.hp -= bonusDmg;
        this._updateHp();
        this._addLog('分裂狂暴！额外 ' + bonusDmg + ' 伤害');
      }
      if (this.hp <= 0) { this.hp = 0; this._updateHp(); this._die(); return; }
    }

    // 怪物技能
    if (this.monsterId === 'spider' && Math.random() < 0.35) {
      this._poisonTurns = 2;
      this._poisonDmg = Math.max(2, Math.round(this.monsterAtk * 0.3));
      this._addLog('被蜘蛛毒液侵蚀，陷入中毒！');
    }
    if (this.monsterId === 'demon' && Math.random() < 0.25) {
      var drain = Math.max(1, Math.round(dmg * 0.5));
      this.monsterHp = Math.min(this.monsterMaxHp, this.monsterHp + drain);
      this._updateMonsterHp();
      this._addLog('恶魔汲取了生命 +' + drain);
    }
    if (this.monsterId === 'orc' && this.monsterHp < this.monsterMaxHp * 0.4 && Math.random() < 0.3) {
      this.monsterAtk = Math.round(this.monsterAtk * 1.2);
      this._addLog('兽人狂暴了！');
    }
    if (this.monsterId === 'wolf' && Math.random() < 0.15) {
      var extra = Math.max(1, Math.round(dmg * 0.6));
      this.hp -= extra;
      this._damageTaken += extra;
      this._updateHp();
      this._addLog('狼群突袭！追加 ' + extra + ' 伤害');
      if (this.hp <= 0) {
        this.hp = 0;
        this._updateHp();
        this._die();
      }
    }
    if (this.monsterId === 'bat' && Math.random() < 0.2) {
      var leech = Math.max(1, Math.round(dmg * 0.4));
      this.monsterHp = Math.min(this.monsterMaxHp, this.monsterHp + leech);
      this._updateMonsterHp();
      this._addLog('蝙蝠吸血 +' + leech);
    }
    if (this.monsterId === 'goblin' && Math.random() < 0.2 && this.gold > 0) {
      var steal = Math.min(this.gold, Math.max(1, Math.round(this.gold * 0.1)));
      this.gold -= steal;
      this._addLog('哥布林偷走了 ' + steal + ' 金币');
    }
    if (this.monsterId === 'yeti' && Math.random() < 0.3) {
      var cold = Math.max(2, Math.round(dmg * 0.4));
      this.hp -= cold;
      this._updateHp();
      this._addLog('雪怪的寒气造成额外 ' + cold + ' 伤害');
      if (this.hp <= 0) {
        this.hp = 0;
        this._updateHp();
        this._die();
      }
    }
    if (this.monsterId === 'abyss_lord' && Math.random() < 0.25) {
      var voidDmg = Math.max(3, Math.round(dmg * 0.5));
      this.hp -= voidDmg;
      this._damageTaken += voidDmg;
      this._updateHp();
      this._addLog('深渊领主侵蚀造成额外 ' + voidDmg + ' 伤害');
      if (this.hp <= 0) {
        this.hp = 0;
        this._updateHp();
        this._die();
      }
    }
    if (this.monsterId === 'ruin_golem' && Math.random() < 0.25) {
      this.monsterHp = Math.min(this.monsterMaxHp, this.monsterHp + Math.round(dmg * 0.4));
      this._updateMonsterHp();
      this._addLog('遗迹巨像汲取石甲回复');
    }
    if (this.monsterId === 'frost_king' && Math.random() < 0.25) {
      var freeze = Math.max(3, Math.round(dmg * 0.5));
      this.hp -= freeze;
      this._damageTaken += freeze;
      this._updateHp();
      this._addLog('霜冻王的寒气造成额外 ' + freeze + ' 伤害');
      if (this.hp <= 0) {
        this.hp = 0;
        this._updateHp();
        this._die();
      }
    }
    if ((this.monsterId === 'fire_imp' || this.monsterId === 'lava_golem' || this.monsterId === 'inferno_lord') && Math.random() < 0.3) {
      var burn = Math.max(2, Math.round(dmg * 0.5));
      this.hp -= burn;
      this._updateHp();
      this._addLog('灼热气息造成额外 ' + burn + ' 伤害');
      if (this.hp <= 0) {
        this.hp = 0;
        this._updateHp();
        this._die();
      }
    }

    if (this.hp <= 0) {
      this.hp = 0;
      this._updateHp();
      this._die();
    }
  },

  _onMonsterDead() {
    this.kills += 1;
    if (this._soulOnKillChance > 0 && Math.random() < this._soulOnKillChance) {
      this.soul += 1;
      this._saveMeta();
      this._addLog('敛魂：灵魂 +1');
    }
    if (this._cdkill > 0 && this.skillCd > 0) {
      this.skillCd = Math.max(0, this.skillCd - 1);
    }
    if (this._bloodlust > 0) {
      this._bloodlust += 1;
    }
    if (this._killHeal > 0 && this.hp < this.maxHp) {
      this.hp = Math.min(this.maxHp, this.hp + this._killHeal);
      this._updateHp();
    }
    this._advanceDaily(this.dailyType === 'kill' ? 1 : 0);
    this.materials += 1 + Math.floor(Math.random() * 2) + (this._materialBonus || 0);
    if (this.isBoss) {
      this.materials += 5;
      this.potions += 1;
      this.talentPoints += 1;
      var ngBonus = (this.ngLevel || 0);
      var msg = 'BOSS 战利品：材料 +5，药水 +1，天赋点 +1';
      if (ngBonus > 0) {
        var bonusSoul = ngBonus * 3;
        var bonusMat = ngBonus * 2;
        this.soul += bonusSoul;
        this.materials += bonusMat;
        msg += '，NG+' + ngBonus + ' 额外：灵魂 +' + bonusSoul + ' 材料 +' + bonusMat;
      }
      this._saveMeta();
      this._addLog(msg);
    } else if (this._isElite) {
      this.materials += 3;
      this._addLog('精英战利品：材料 +3');
    }
    this._discoverMonster(this.monsterId);
    if (this.isBoss) {
      this.bossKills += 1;
      this._advanceDaily(this.dailyType === 'boss' ? 1 : 0);
      var avail = [];
      for (var ri = 0; ri < RELICS.length; ri++) {
        if (this.relics.indexOf(RELICS[ri].id) < 0) {
          avail.push(RELICS[ri].id);
        }
      }
      if (avail.length > 0) {
        this._gainRelic(avail[Math.floor(Math.random() * avail.length)]);
      }
    }
    this._vibrate(120);
    this.gold += Math.round(this.monsterGold * this.goldMul) + this._goldSteal;
    this.exp += Math.round(this.monsterExp * this.expMul);
    this._updateExp();
    var flavors = ['应声倒地！','化为灰烬！','发出最后哀嚎……','轰然崩碎！','化作血水。','不甘消散。','倒在你面前。','痛苦嘶吼后倒下。'];
    var flavor = flavors[Math.floor(Math.random() * flavors.length)];
    var rewardText = '击杀 ' + this.monsterName + flavor;
    if (this.monsterGold > 0 || this.monsterExp > 0) {
      rewardText += ' +' + Math.round(this.monsterGold * this.goldMul) + '金 +' + Math.round(this.monsterExp * this.expMul) + '经验';
    }
    this._addLog(rewardText);
    if (this.isBoss) {
      this._addLog('BOSS 已被击败！');
    }

    // 从地图上移除怪物，玩家进入原怪物位置
    for (var i = 0; i < this._monsters.length; i++) {
      if (this._monsters[i].row === this._battleMonsterR && this._monsters[i].col === this._battleMonsterC) {
        this._monsters.splice(i, 1);
        break;
      }
    }
    if (!this._isElite) {
      this._playerR = this._battleMonsterR;
      this._playerC = this._battleMonsterC;
    }

    this._dropWeapon();
    this._dropArmor();
    this._checkAchievements();

    if (this.exp >= this.expNext) {
      this._openReward();
    } else {
      this.phase = 'grid';
      this._renderMap();
      this._saveRun();
    }
  },

  _dropWeapon() {
    if (Math.random() >= 0.35) {
      return;
    }
    var weapon = this._rollWeapon();
    if (weapon.atk > this.weaponAtk) {
      this.weaponAtk = weapon.atk;
      this.weaponName = weapon.name;
      this.atk = this.baseAtk + this.weaponAtk;
      this.skillName = this._skillName();
      this._addLog('获得武器 ' + weapon.name + '，攻击 +' + weapon.atk);
    } else {
      this._addLog('获得 ' + weapon.name + '，但不如当前武器');
    }
  },

  _dropArmor() {
    if (Math.random() >= 0.25) {
      return;
    }
    var armor = this._rollArmor();
    if (armor.def > this.armorDef) {
      this.armorDef = armor.def;
      this.armorName = armor.name;
      this.dodge = armor.dodge || 0;
      this._addLog('获得防具 ' + armor.name + '，防御 +' + armor.def);
    } else {
      this._addLog('获得 ' + armor.name + '，但不如当前防具');
    }
  },

  closeTutorial() {
    this.phase = 'grid';
    this._renderMap();
    this._saveRun();
  },

  _openEvent() {
    var events = [
      { title: '神秘宝箱', desc: '箱子上布满灰尘。', options: [
        { label: '打开', effect: 'gold', value: 18 },
        { label: '离开', effect: 'none' }
      ] },
      { title: '受伤旅人', desc: '旅人恳求你分他药水。', options: [
        { label: '帮助(-1药水)', effect: 'potion', value: -1 },
        { label: '无视', effect: 'none' }
      ] },
      { title: '古老祭坛', desc: '祭坛似乎在渴求鲜血。', options: [
        { label: '献祭(-12血)', effect: 'hp', value: -12 },
        { label: '离开', effect: 'none' }
      ] },
      { title: '补给箱', desc: '里面似乎有物资。', options: [
        { label: '搜刮', effect: 'potion', value: 1 },
        { label: '离开', effect: 'none' }
      ] },
      { title: '行脚商人', desc: '商人在兜售补给。', options: [
        { label: '买药水(-15金)', cost: 15, potion: 1 },
        { label: '无视', effect: 'none' }
      ] },
      { title: '幸运符', desc: '一枚散发微光的符咒。', options: [
        { label: '拾取', effect: 'buff', value: 'luck' },
        { label: '离开', effect: 'none' }
      ] },
      { title: '温暖温泉', desc: '热气腾腾的泉水。', options: [
        { label: '泡澡', effect: 'hp', value: 25 },
        { label: '离开', effect: 'none' }
      ] },
      { title: '陷阱房', desc: '脚下传来机关声。', options: [
        { label: '小心通过', effect: 'trap' },
        { label: '绕道', effect: 'none' }
      ] },
      { title: '流浪铁匠', desc: '铁匠愿为你加固武器。', options: [
        { label: '打磨(+3攻,50金)', cost: 50, buff: 'atk' },
        { label: '拒绝', effect: 'none' }
      ] },
      { title: '盔甲匠', desc: '盔甲匠可加固你的护甲。', options: [
        { label: '加固(+3防,40金)', cost: 40, buff: 'def' },
        { label: '拒绝', effect: 'none' }
      ] },
      { title: '神秘井', desc: '井水泛起奇异微光。', options: [
        { label: '饮下', effect: 'well' },
        { label: '离开', effect: 'none' }
      ] },
      { title: '医疗站', desc: '废弃的医疗仓还在运转。', options: [
        { label: '治疗(+50血)', effect: 'heal50' },
        { label: '离开', effect: 'none' }
      ] },
      { title: '军械库', desc: '尘封的武器架上还有装备。', options: [
        { label: '挑武器', effect: 'gearWeapon' },
        { label: '挑防具', effect: 'gearArmor' }
      ] },
      { title: '赌局', desc: '一个神秘人想和你赌一把。', options: [
        { label: '下注50金', effect: 'gamble', value: 50 },
        { label: '离开', effect: 'none' }
      ] },
      { title: '收藏家', desc: '收藏家愿意出高价收药水。', options: [
        { label: '卖1药水(+25金)', effect: 'tradePotion', value: 25 },
        { label: '离开', effect: 'none' }
      ] },
      { title: '迷路精灵', desc: '精灵愿为你指明道路。', options: [
        { label: '传送至楼梯', effect: 'teleport' },
        { label: '拒绝', effect: 'none' }
      ] },
      { title: '古老咒语', desc: '墙上刻着晦涩的文字。', options: [
        { label: '解读', effect: 'curse' },
        { label: '离开', effect: 'none' }
      ] }
    ];
    var e = events[Math.floor(Math.random() * events.length)];
    this.eventTitle = e.title;
    this.eventDesc = e.desc;
    this.eventOptions = e.options;
    this.phase = 'event';
  },

  chooseEvent(idx) {
    var opt = this.eventOptions[idx];
    if (opt) {
      if (opt.effect === 'gold') {
        this.gold += opt.value;
        this._addLog('事件获得 ' + opt.value + ' 金币');
      } else if (opt.effect === 'potion') {
        if (this.potions + opt.value >= 0) {
          this.potions += opt.value;
          this._addLog(opt.value > 0 ? '事件获得药水' : '事件消耗药水');
        } else {
          this._addLog('你已没有足够的药水');
        }
      } else if (opt.effect === 'hp') {
        this.hp = Math.max(1, this.hp + opt.value);
        this._updateHp();
        this._addLog(opt.value < 0 ? '你付出了代价' : '你恢复了生命');
      } else if (opt.cost && opt.buff === 'atk') {
        if (this.gold >= 50) {
          this.gold -= 50;
          this.baseAtk += 3;
          this.atk = this.baseAtk + this.weaponAtk;
          this._addLog('铁匠打磨，攻击 +3');
        } else {
          this._addLog('金币不足');
        }
      } else if (opt.cost && opt.buff === 'def') {
        if (this.gold >= 40) {
          this.gold -= 40;
          this.armorDef += 3;
          this._addLog('盔甲加固，防御 +3');
        } else {
          this._addLog('金币不足');
        }
      } else if (opt.cost) {
        if (this.gold >= opt.cost) {
          this.gold -= opt.cost;
          if (opt.potion) {
            this.potions += opt.potion;
            this._addLog('购买药水，花费 ' + opt.cost + ' 金币');
          }
        } else {
          this._addLog('金币不足');
        }
      } else if (opt.effect === 'buff') {
        var roll = Math.random();
        if (roll < 0.4) {
          this.baseAtk += 2;
          this.atk = this.baseAtk + this.weaponAtk;
          this._addLog('幸运符：攻击 +2');
        } else if (roll < 0.7) {
          this.critChance += 0.05;
          this._addLog('幸运符：暴击 +5%');
        } else {
          this.gold += 20;
          this._addLog('幸运符：获得 20 金币');
        }
      } else if (opt.effect === 'gamble') {
        if (this.gold < opt.value) {
          this._addLog('金币不足');
        } else if (Math.random() < 0.5) {
          this.gold += opt.value;
          this._addLog('赌局获胜 +' + opt.value + ' 金币');
        } else {
          this.gold -= opt.value;
          this._addLog('赌局失败，失去 ' + opt.value + ' 金币');
        }
      } else if (opt.effect === 'tradePotion') {
        if (this.potions >= 1) {
          this.potions -= 1;
          this.gold += opt.value;
          this._addLog('售出药水 +' + opt.value + ' 金币');
        } else {
          this._addLog('没有药水可卖');
        }
      } else if (opt.effect === 'teleport') {
        this._playerR = this._stairsR;
        this._playerC = this._stairsC;
        this._revealAround();
        this._addLog('精灵将你传送至楼梯处');
      } else if (opt.effect === 'curse') {
        var cr = Math.random();
        if (cr < 0.4) {
          this.baseAtk += 2;
          this.atk = this.baseAtk + this.weaponAtk;
          this._addLog('咒语强化：攻击 +2');
        } else if (cr < 0.7) {
          this.maxHp += 10;
          this.hp = Math.min(this.maxHp, this.hp + 10);
          this._updateHp();
          this._addLog('咒语强化：生命上限 +10');
        } else {
          this.gold += 20;
          this._addLog('咒语赐予金币 +20');
        }
      } else if (opt.effect === 'heal50') {
        this.hp = Math.min(this.maxHp, this.hp + 50);
        this._updateHp();
        this._addLog('医疗站恢复 50 生命');
      } else if (opt.effect === 'gearWeapon') {
        this._equipRolled(this._rollWeapon());
      } else if (opt.effect === 'gearArmor') {
        this._equipRolledArmor(this._rollArmor());
      } else if (opt.effect === 'well') {
        var wr = Math.random();
        if (wr < 0.4) {
          this.hp = Math.min(this.maxHp, this.hp + 20);
          this._updateHp();
          this._addLog('井水回复生命');
        } else if (wr < 0.7) {
          this.gold += 25;
          this._addLog('井中涌出金币 +25');
        } else {
          this.baseAtk += 2;
          this.atk = this.baseAtk + this.weaponAtk;
          this._addLog('井水赐予力量，攻击 +2');
        }
      } else if (opt.effect === 'trap') {
        var trapDmg = Math.max(3, Math.round(8 + this.floor * 0.6));
        this.hp -= trapDmg;
        this._updateHp();
        this._addLog('机关触发，受到 ' + trapDmg + ' 伤害');
        if (this.hp <= 0) {
          this.hp = 0;
          this._updateHp();
          this._die();
        }
      }
    }
    this.phase = 'grid';
    this._renderMap();
  },

  _updateTalentList() {
    this.talentList = TALENTS.map(function(t) {
      return { id: t.id, name: t.name, desc: t.desc, bought: this.talents.indexOf(t.id) >= 0 };
    }.bind(this));
  },

  _checkPromotion() {
    if (this.promoted) return;
    var cls = this._classBase();
    if (!cls.promoteLv || this.level < cls.promoteLv) return;
    var pb = cls.promoteBonus || {};
    this.promoted = true;
    this.promoteName = cls.promoteName;
    if (pb.atkAdd) { this.baseAtk += pb.atkAdd; this.atk = this.baseAtk + this.weaponAtk; }
    if (pb.hpAdd) { this.maxHp += pb.hpAdd; }
    if (pb.dodgeAdd) { this.dodge += pb.dodgeAdd; }
    if (pb.critAdd) { this.critChance += pb.critAdd; }
    if (pb.crit) { this.critChance += pb.crit; }
    if (pb.skillPower) { this._skillPowerAdd += pb.skillPower; }
    this._vibrate(300);
    this._addLog('★ 转职成功！你成为了 ' + cls.promoteName + '！');
    this._saveRun();
  },

  _applyTalent(t) {
    if (t.stat === 'atk') {
      this.baseAtk += t.value;
      this.atk = this.baseAtk + this.weaponAtk;
    } else if (t.stat === 'hp') {
      this.maxHp += t.value;
    } else if (t.stat === 'goldMul') {
      this.goldMul += t.value;
    } else if (t.stat === 'expMul') {
      this.expMul += t.value;
    } else if (t.stat === 'lifesteal') {
      this.lifesteal += t.value;
    } else if (t.stat === 'burnChance') {
      this.burnChance += t.value;
    } else if (t.stat === 'shield') {
      this._shield += t.value;
    } else if (t.stat === 'haste') {
      this._hasteCharges += t.value;
    } else if (t.stat === 'combo') {
      this._comboMaxAdd += t.value;
    }
  },

  openTalents() {
    this._updateTalentList();
    this._lastPhase = this.phase;
    this.phase = 'talents';
  },

  closeTalents() {
    if (this.phase === 'talents') {
      this.phase = this._lastPhase || 'grid';
      if (this.phase === 'grid') {
        this._renderMap();
      }
    }
  },

  _removeTalent(t) {
    if (t.stat === 'atk') {
      this.baseAtk = Math.max(0, this.baseAtk - t.value);
      this.atk = this.baseAtk + this.weaponAtk;
    } else if (t.stat === 'hp') {
      this.maxHp = Math.max(1, this.maxHp - t.value);
      this.hp = Math.min(this.hp, this.maxHp);
    } else if (t.stat === 'goldMul') {
      this.goldMul = Math.max(0, this.goldMul - t.value);
    } else if (t.stat === 'expMul') {
      this.expMul = Math.max(0, this.expMul - t.value);
    } else if (t.stat === 'lifesteal') {
      this.lifesteal = Math.max(0, this.lifesteal - t.value);
    } else if (t.stat === 'burnChance') {
      this.burnChance = Math.max(0, this.burnChance - t.value);
    } else if (t.stat === 'shield') {
      this._shield = Math.max(0, this._shield - t.value);
    } else if (t.stat === 'haste') {
      this._hasteCharges = Math.max(0, this._hasteCharges - t.value);
    } else if (t.stat === 'combo') {
      this._comboMaxAdd = Math.max(0, this._comboMaxAdd - t.value);
    }
    this._updateHp();
  },

  resetTalents() {
    if (this.phase !== 'talents' || this.talents.length === 0) {
      return;
    }
    for (var i = 0; i < this.talents.length; i++) {
      for (var j = 0; j < TALENTS.length; j++) {
        if (TALENTS[j].id === this.talents[i]) {
          this._removeTalent(TALENTS[j]);
          break;
        }
      }
    }
    this.talentPoints += this.talents.length;
    this.talents = [];
    this._updateTalentList();
    this._addLog('已重置天赋，返还 ' + this.talentPoints + ' 点');
  },

  buyTalent(id) {
    if (this.phase !== 'talents' || this.talentPoints <= 0 || this.talents.indexOf(id) >= 0) {
      return;
    }
    var t = null;
    for (var i = 0; i < TALENTS.length; i++) {
      if (TALENTS[i].id === id) {
        t = TALENTS[i];
        break;
      }
    }
    if (!t) {
      return;
    }
    this.talentPoints -= 1;
    this.talents.push(id);
    this._applyTalent(t);
    this._updateTalentList();
    this._addLog('习得天赋 ' + t.name);
  },

  _gainRelic(id) {
    var relic = null;
    for (var i = 0; i < RELICS.length; i++) {
      if (RELICS[i].id === id) {
        relic = RELICS[i];
        break;
      }
    }
    if (!relic) {
      return;
    }
    if (this.relics.indexOf(id) >= 0) {
      return;
    }
    this.relics.push(id);
    if (this.relicCodex.indexOf(id) < 0) {
      this.relicCodex.push(id);
      this._saveMeta();
      if (this.relicCodex.length >= this.relicTotal && this.relicTotal > 0) {
        this._unlockAchievement('relic_master');
      }
    }
    if (relic.stat === 'atk') {
      this.baseAtk += relic.value;
      this.atk = this.baseAtk + this.weaponAtk;
    } else if (relic.stat === 'hp') {
      this.maxHp += relic.value;
    } else if (relic.stat === 'goldMul') {
      this.goldMul += relic.value;
    } else if (relic.stat === 'expMul') {
      this.expMul += relic.value;
    } else if (relic.stat === 'cd') {
      this.skillCdMax = Math.max(1, this.skillCdMax - relic.value);
    } else if (relic.stat === 'shield') {
      this._shield += relic.value;
    } else if (relic.stat === 'haste') {
      this._hasteCharges += relic.value;
    } else if (relic.stat === 'combo') {
      this._comboMaxAdd += relic.value;
    }
    this._addLog('获得遗物：' + relic.name + '（' + relic.desc + '）');
  },

  _openReward() {
    this.phase = 'reward';
    var pool = UPGRADES.slice();
    var options = [];
    for (var i = 0; i < 3 && pool.length > 0; i++) {
      var idx = Math.floor(Math.random() * pool.length);
      options.push(pool.splice(idx, 1)[0]);
    }
    this.upgradeOptions = options;
  },

  chooseUpgrade(id) {
    if (id === 'atk') {
      this.baseAtk += 4;
      this.atk = this.baseAtk + this.weaponAtk;
    } else if (id === 'hp') {
      this.maxHp += 25;
      this.hp = Math.min(this.maxHp, this.hp + 25);
    } else if (id === 'potion') {
      this.potions += 1;
    } else if (id === 'heal') {
      this.hp = Math.min(this.maxHp, this.hp + 40);
    } else if (id === 'gold') {
      this.gold += 15;
    } else if (id === 'goldmul') {
      this.goldMul += 0.15;
    } else if (id === 'expmul') {
      this.expMul += 0.15;
    } else if (id === 'crit') {
      this.critChance += 0.08;
    } else if (id === 'critdmg') {
      this.critMult += 0.3;
    } else if (id === 'lifesteal') {
      this.lifesteal += 2;
    } else if (id === 'burn') {
      this.burnChance += 0.1;
    } else if (id === 'cd') {
      this.skillCdMax = Math.max(1, this.skillCdMax - 0.3);
    } else if (id === 'omni') {
      this.baseAtk += 2;
      this.atk = this.baseAtk + this.weaponAtk;
      this.goldMul += 0.05;
      this.expMul += 0.05;
    } else if (id === 'shield') {
      this._shield += 15;
    } else if (id === 'haste') {
      this._hasteCharges += 1;
    } else if (id === 'dodgeup') {
      this.dodge += 3;
    } else if (id === 'materials') {
      this.materials += 3;
    } else if (id === 'gold100') {
      this.gold += 20;
    } else if (id === 'regen') {
      this._regen += 2;
    } else if (id === 'thorns') {
      this._thorns += 3;
    } else if (id === 'holy') {
      this._killHeal += 5;
    } else if (id === 'loot') {
      this._goldSteal += 3;
    } else if (id === 'skillpower') {
      this._skillPowerAdd += 0.5;
    } else if (id === 'freeze') {
      this._freezeChance += 0.15;
    } else if (id === 'block') {
      this._blockChance += 0.2;
    } else if (id === 'barrier') {
      this._barrier += 8;
    } else if (id === 'berserk') {
      this._berserk = true;
    } else if (id === 'skillcombo') {
      this._skillCombo += 2;
    } else if (id === 'vision') {
      this._revealBonus += 1;
    } else if (id === 'combocap') {
      this._comboMaxAdd += 0.2;
    } else if (id === 'treasure') {
      this._treasureBonus += 1;
    } else if (id === 'vigor') {
      this._floorHeal += 8;
    } else if (id === 'ironhide') {
      this._bonusDef += 2;
    } else if (id === 'bloodlust') {
      this._bloodlust = 1;
    } else if (id === 'gale') {
      this._startHaste += 1;
    } else if (id === 'lootmat') {
      this._materialBonus += 1;
    } else if (id === 'healboost') {
      this._healBoost += 10;
    } else if (id === 'intimidate') {
      this._intimidate = true;
    } else if (id === 'resolve') {
      this._resolve = true;
    } else if (id === 'stun') {
      this._stunChance += 0.15;
    } else if (id === 'execute') {
      this._execute = true;
    } else if (id === 'artisan') {
      this._craftDiscount += 0.2;
    } else if (id === 'cdkill') {
      this._cdkill = 1;
    } else if (id === 'clean') {
      this._cleanChance += 0.25;
    } else if (id === 'opening') {
      this._openingStrike += 8;
    } else if (id === 'thunder') {
      this._thunderChance += 0.2;
    } else if (id === 'guarded') {
      this._shieldGainChance += 0.25;
      this._shieldGainAmt += 4;
    } else if (id === 'critgold') {
      this._critGold += 5;
    } else if (id === 'comboHit') {
      this._comboOnHit += 0.2;
    } else if (id === 'haggle') {
      this._haggle += 0.15;
    } else if (id === 'potionShield') {
      this._potionShield += 8;
    } else if (id === 'potionCombo') {
      this._potionCombo += 2;
    } else if (id === 'critCombo') {
      this._critCombo += 1;
    } else if (id === 'soulKill') {
      this._soulOnKillChance += 0.2;
    } else if (id === 'stairvision') {
      this._stairVision = true;
    } else if (id === 'startCombo') {
      this._startCombo += 2;
    } else if (id === 'comboHeal') {
      this._comboHeal += 4;
    } else if (id === 'levelShield') {
      this._levelShield += 10;
    } else if (id === 'warcry') {
      this._warcry += 3;
    } else if (id === 'startShield') {
      this._startShield += 10;
    } else if (id === 'fullvision') {
      this._fullVision = true;
    } else if (id === 'forgeMaster') {
      this._forgeBonus += 1;
    } else if (id === 'critMaster') {
      this.critMult += 0.3;
    } else if (id === 'lifesteal2') {
      this.lifesteal += 2;
    } else if (id === 'cd2') {
      this.skillCdMax = Math.max(1, this.skillCdMax - 0.3);
    } else if (id === 'goldMaster') {
      this.goldMul += 0.15;
    } else if (id === 'expMaster') {
      this.expMul += 0.15;
    } else if (id === 'luck') {
      this._luck += 1;
    } else if (id === 'shieldReflect') {
      this._shieldReflect += 0.5;
    } else if (id === 'revive') {
      this._revive = true;
    } else if (id === 'comboPower') {
      this._comboPerStack += 0.01;
    } else if (id === 'keenEye') {
      this.critChance += 0.05;
    } else if (id === 'dodge2') {
      this.dodge += 3;
    } else if (id === 'thorns2') {
      this._thorns += 3;
    } else if (id === 'shieldgain2') {
      this._shieldGainAmt += 4;
    } else if (id === 'burn2') {
      this.burnChance += 0.05;
    } else if (id === 'thunder2') {
      this._thunderChance += 0.2;
    } else if (id === 'freeze2') {
      this._freezeChance += 0.15;
    } else if (id === 'stun2') {
      this._stunChance += 0.15;
    } else if (id === 'block2') {
      this._blockChance += 0.2;
    } else if (id === 'clean2') {
      this._cleanChance += 0.25;
    } else if (id === 'healboost2') {
      this._healBoost += 10;
    } else if (id === 'material2') {
      this._materialBonus += 1;
    } else if (id === 'skillpower2') {
      this._skillPowerAdd += 0.5;
    } else if (id === 'omni2') {
      this.baseAtk += 1;
      this.atk = this.baseAtk + this.weaponAtk;
      this.maxHp += 5;
      this.goldMul += 0.02;
      this.expMul += 0.02;
    } else if (id === 'levelhp') {
      this._levelHp += 5;
    } else if (id === 'hppct') {
      var gain = Math.round(this.maxHp * 0.1);
      this.maxHp += gain;
      this.hp = Math.min(this.maxHp, this.hp + gain);
    }

    this.level += 1;
    this.talentPoints += 1;
    if (this._levelHp > 0) {
      this.maxHp += this._levelHp;
    }
    if (this._levelShield > 0) {
      this._shield += this._levelShield;
    }
    this._advanceDaily(this.dailyType === 'level' ? 1 : 0);
    this._checkPromotion();
    this._vibrate(160);
    this.exp -= this.expNext;
    this.expNext = Math.floor(this.expNext * 1.35);
    this._updateExp();
    this._updateHp();
    this._checkAchievements();
    this.phase = 'grid';
    this._renderMap();
    this._saveRun();
    this._addLog('升级到 Lv.' + this.level);
  },

  _monstersTurn() {
    for (var i = 0; i < this._monsters.length; i++) {
      var mon = this._monsters[i];
      if (!mon.alive) {
        continue;
      }
      var dr = this._playerR - mon.row;
      var dc = this._playerC - mon.col;
      if (Math.abs(dr) + Math.abs(dc) === 1) {
        // 相邻攻击
        var stats = this._monsterStats(mon.id);
        var dmg = Math.max(1, Math.round((stats.atk - this.armorDef) * (0.85 + Math.random() * 0.3)));
        this.hp -= dmg;
        this._updateHp();
        this._addLog(stats.name + ' 攻击你 ' + dmg);
        if (this.hp <= 0) {
          this.hp = 0;
          this._updateHp();
          this._die();
          return;
        }
      } else {
        if (Math.abs(dr) + Math.abs(dc) > 3 && Math.random() < 0.25) {
          this._chargeMonster(mon, dr, dc);
        } else {
          this._moveMonster(mon, dr, dc);
        }
      }
    }
  },

  _surroundMove(mon, dr, dc) {
    var sideDr = dc !== 0 ? Math.sign(dr) : 0;
    var sideDc = dr !== 0 ? Math.sign(dc) : 0;
    var attempts = [[sideDr || (Math.random() < 0.5 ? 1 : -1), 0], [0, sideDc || (Math.random() < 0.5 ? 1 : -1)]];
    for (var a = 0; a < attempts.length; a++) {
      var nr = mon.row + attempts[a][0];
      var nc = mon.col + attempts[a][1];
      if (nr >= 0 && nr < this._height && nc >= 0 && nc < this._width &&
          this._grid[nr][nc] !== '#' && this._grid[nr][nc] !== 'S' &&
          !this._monsterAt(nr, nc) && !(nr === this._playerR && nc === this._playerC)) {
        mon.row = nr; mon.col = nc;
        return;
      }
    }
    this._moveMonster(mon, dr, dc);
  },

  _chargeMonster(mon, dr, dc) {
    this._moveMonster(mon, dr, dc);
    var dr2 = this._playerR - mon.row;
    var dc2 = this._playerC - mon.col;
    this._moveMonster(mon, dr2, dc2);
  },

  _moveMonster(mon, dr, dc) {
    var horizontal = Math.abs(dc) > Math.abs(dr);
    var attempts = horizontal ? [[0, Math.sign(dc)], [Math.sign(dr), 0]] : [[Math.sign(dr), 0], [0, Math.sign(dc)]];
    for (var a = 0; a < attempts.length; a++) {
      var nr = mon.row + attempts[a][0];
      var nc = mon.col + attempts[a][1];
      if (nr < 0 || nr >= this._height || nc < 0 || nc >= this._width) {
        continue;
      }
      if (this._grid[nr][nc] === '#') {
        continue;
      }
      if (this._monsterAt(nr, nc) || this._itemAt(nr, nc)) {
        continue;
      }
      if (nr === this._playerR && nc === this._playerC) {
        continue;
      }
      mon.row = nr;
      mon.col = nc;
      break;
    }
  },

  _afterMonstersTurn() {
    if (this.phase === 'dead') {
      return;
    }
    this._renderMap();
    this._saveRun();
  },

  _die() {
    if (this._revive && !this._reviveUsed) {
      this._reviveUsed = true;
      this.hp = Math.max(1, Math.round(this.maxHp * 0.3));
      this._updateHp();
      this.monsterAlive = false;
      this.phase = 'grid';
      this._vibrate(200);
      this._addLog('涅槃重生！恢复 30% 生命');
      this._renderMap();
      return;
    }
    this.phase = 'dead';
    this._vibrate(200);
    this._clearSave();
    if (this.floor >= 15 && this.ngLevel < 5) {
      this.ngLevel += 1;
      this._saveMeta();
      this._addLog('轮回等级提升至 NG+' + this.ngLevel);
    }
    var soulBase = this.floor * 2 + this.level;
    var soulMul = this.difficulty === 0 ? 0.8 : (this.difficulty === 2 ? 1.3 : 1);
    if (this.challengeMode) {
      soulMul *= 1.2;
    }
    if (this.endless) {
      soulMul *= 1.1;
    }
    this.soul += Math.round(soulBase * soulMul);
    this._saveMeta();
    if (this.floor > this.best) {
      this.best = this.floor;
      storage.set({
        key: this._bestKey(),
        value: String(this.floor)
      });
    }
  },

  doRest() {
    if (this.phase !== 'grid') {
      return;
    }
    if (this.challengeMode) {
      this._addLog('挑战模式：无法休息');
      return;
    }
    var heal = Math.round(this.maxHp * 0.25);
    this.hp = Math.min(this.maxHp, this.hp + heal);
    this._updateHp();
    this._addLog('休息片刻，回复 ' + heal + ' 生命');
    this._monstersTurn();
    this._afterMonstersTurn();
    this._saveRun();
  },

  usePotion() {
    if (this.phase !== 'grid' || this.potions <= 0 || this.hp >= this.maxHp) {
      return;
    }
    if (this.challengeMode) {
      this._addLog('挑战模式：无法使用药水');
      return;
    }
    this.potions -= 1;
    var healAmt = this._healAmount();
    this.hp = Math.min(this.maxHp, this.hp + healAmt);
    if (this._potionShield > 0) {
      this._shield += this._potionShield;
    }
    if (this._potionCombo > 0) {
      this.combo += this._potionCombo;
    }
    this._updateHp();
    this._addLog('使用药水，回复 ' + healAmt + ' 生命' + (this._potionShield > 0 ? '，获得护盾' : ''));
    this._monstersTurn();
    this._afterMonstersTurn();
    this._saveRun();
  },

  _updateCodexCount() {
    this.codexTotal = Object.keys(MONSTERS).length;
    this.codexCount = this.codex.length;
    this.codexList = Object.keys(MONSTERS).map(function(id) {
      return { id: id, name: MONSTERS[id].name, found: this.codex.indexOf(id) >= 0 };
    }.bind(this));
    if (this.codexCount >= this.codexTotal && this.codexTotal > 0) {
      this._unlockAchievement('codex_master');
    }
  },

  _discoverMonster(id) {
    GameProgress.discoverMonster(this, id);
  },

  openCodex() {
    this._updateCodexCount();
    this.phase = 'codex';
  },

  closeCodex() {
    this.phase = 'home';
  },

  _updateAchievementCount() {
    GameProgress.updateAchievementCount(this);
  },

  _unlockAchievement(id) {
    GameProgress.unlockAchievement(this, id);
  },

  _achievementName(id) {
    return GameProgress.achievementName(ACHIEVEMENTS, id);
  },

  _checkAchievements() {
    if (this.kills >= 1) { this._unlockAchievement('first_kill'); }
    if (this.floor >= 5) { this._unlockAchievement('floor_5'); }
    if (this.floor >= 10) { this._unlockAchievement('floor_10'); }
    if (this.level >= 10) { this._unlockAchievement('level_10'); }
    if (this.bossKills >= 1) { this._unlockAchievement('boss_slayer'); }
    if (this.gold >= 100) { this._unlockAchievement('rich'); }
    if (this.potions >= 3) { this._unlockAchievement('potion_master'); }
    if (this.kills >= 50) { this._unlockAchievement('kill_50'); }
    if (this.floor >= 15) { this._unlockAchievement('floor_15'); }
    if (this.gold >= 500) { this._unlockAchievement('rich_500'); }
    if (this.bossKills >= 5) { this._unlockAchievement('boss_5'); }
  },

  openAchievements() {
    this._updateAchievementCount();
    this.phase = 'achievements';
  },

  closeAchievements() {
    this.phase = 'home';
  },

  _initDailyTask() {
    GameProgress.initDailyTask(this);
  },

  _newDailyTask() {
    var types = ['kill', 'floor', 'boss', 'level'];
    this.dailyType = types[Math.floor(Math.random() * types.length)];
    if (this.dailyType === 'kill') {
      this.dailyTarget = 5;
      this.dailyLabel = '击杀 5 个怪物';
    } else if (this.dailyType === 'floor') {
      this.dailyTarget = 3;
      this.dailyLabel = '到达第 3 层';
    } else if (this.dailyType === 'boss') {
      this.dailyTarget = 1;
      this.dailyLabel = '击败 1 个 BOSS';
    } else {
      this.dailyTarget = 5;
      this.dailyLabel = '达到 Lv.5';
    }
    this.dailyProgress = 0;
    this.dailyDone = false;
    storage.set({
      key: 'BAND_SURVIVOR_DAILYTASK',
      value: JSON.stringify({ date: this._todayStr(), type: this.dailyType, target: this.dailyTarget, progress: this.dailyProgress, done: this.dailyDone })
    });
  },

  _refreshDailyLabel() {
    if (this.dailyType === 'kill') {
      this.dailyLabel = '击杀 5 个怪物';
    } else if (this.dailyType === 'boss') {
      this.dailyLabel = '击败 1 个 BOSS';
    } else if (this.dailyType === 'level') {
      this.dailyLabel = '达到 Lv.5';
    } else {
      this.dailyLabel = '到达第 3 层';
    }
  },

  _advanceDaily(amount) {
    GameProgress.advanceDaily(this, amount || 1);
  },

  claimDailyTask() {
    GameProgress.claimDailyTask(this);
  },

  _todayStr() {
    var d = new Date();
    return d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
  },

  _checkDaily() {
    GameProgress.checkDaily(this);
  },

  claimDaily() {
    GameProgress.claimDaily(this);
  },

  _saveMeta() {
    storage.set({
      key: 'BAND_SURVIVOR_META',
      value: JSON.stringify({ soul: this.soul, metaHp: this.metaHp, metaPotion: this.metaPotion, metaAtk: this.metaAtk, bestWeaponAtk: this.bestWeaponAtk, bestArmorDef: this.bestArmorDef, relicCodex: this.relicCodex, equipCodex: this.equipCodex, ngLevel: this.ngLevel })
    });
  },

  _updateMetaList() {
    this.metaUpgradeCostHp = 20 + this.metaHp * 20;
    this.metaUpgradeCostPotion = 25 + this.metaPotion * 25;
    this.metaUpgradeCostAtk = 30 + this.metaAtk * 30;
  },

  openHelp() {
    this._lastPhase = this.phase;
    this.phase = 'help';
  },

  closeHelp() {
    this.phase = this._lastPhase || 'pause';
  },

  openMeta() {
    this._updateMetaList();
    this.phase = 'meta';
  },

  closeMeta() {
    this.phase = 'home';
  },

  buyMetaHp() {
    if (this.soul < this.metaUpgradeCostHp) { this._addLog('灵魂不足'); return; }
    this.soul -= this.metaUpgradeCostHp;
    this.metaHp += 10;
    this._saveMeta();
    this._updateMetaList();
  },

  buyMetaPotion() {
    if (this.soul < this.metaUpgradeCostPotion) { this._addLog('灵魂不足'); return; }
    this.soul -= this.metaUpgradeCostPotion;
    this.metaPotion += 1;
    this._saveMeta();
    this._updateMetaList();
  },

  buyMetaAtk() {
    if (this.soul < this.metaUpgradeCostAtk) { this._addLog('灵魂不足'); return; }
    this.soul -= this.metaUpgradeCostAtk;
    this.metaAtk += 2;
    this._saveMeta();
    this._updateMetaList();
  },

  _updateClassLabel() {
    for (var i = 0; i < CLASSES.length; i++) {
      if (CLASSES[i].id === this.charClass) {
        this.classLabel = CLASSES[i].name;
        return;
      }
    }
    this.classLabel = '战士';
  },

  _classBase() {
    return classById(CLASSES, this.charClass);
  },

  setClass(id) {
    var ok = false;
    for (var i = 0; i < CLASSES.length; i++) {
      if (CLASSES[i].id === id) {
        this.charClass = id;
        this._updateClassLabel();
        storage.set({ key: 'BAND_SURVIVOR_CLASS', value: id });
        ok = true;
        break;
      }
    }
    return ok;
  },

  _applyChallengeMod() {
    if (!this.challengeMode || this.challengeMod) {
      return;
    }
    var mod = CHALLENGE_MODS[Math.floor(Math.random() * CHALLENGE_MODS.length)];
    this.challengeMod = mod.id;
    if (mod.atkMul) {
      this.baseAtk = Math.round(this.baseAtk * mod.atkMul);
      this.atk = this.baseAtk + this.weaponAtk;
    }
    if (mod.hpMul) {
      this.maxHp = Math.round(this.maxHp * mod.hpMul);
      this.hp = Math.min(this.hp, this.maxHp);
    }
    if (mod.atkAdd) {
      this.baseAtk += mod.atkAdd;
      this.atk = this.baseAtk + this.weaponAtk;
    }
    if (mod.hpAdd) {
      this.maxHp += mod.hpAdd;
    }
    if (mod.goldMul) {
      this.goldMul *= mod.goldMul;
    }
    if (mod.expMul) {
      this.expMul *= mod.expMul;
    }
    this._updateHp();
    this._addLog('挑战词条：' + mod.name + '（' + mod.desc + '）');
  },

  startNGPlus() {
    if (this.ngLevel <= 0) return;
    this.ngActive = true;
    this._resetRun();
    this.phase = this.tutorialSeen ? 'grid' : 'tutorial';
    this._genFloor(1);
    this._addLog('轮回 NG+' + this.ngLevel + ' 开始！敌人更强大……');
    this._saveRun();
  },

  _saveSettings() {
    storage.set({
      key: 'BAND_SURVIVOR_SET',
      value: JSON.stringify({ vibrate: this.vibrateOn, sensitivity: this.sensitivity })
    });
  },

  _updateSensLabel() {
    this.sensLabel = sensLabel(this.sensitivity);
  },

  toggleVibrate() {
    this.vibrateOn = !this.vibrateOn;
    this._saveSettings();
  },

  cycleSensitivity() {
    this.sensitivity = (this.sensitivity + 1) % 3;
    this._updateSensLabel();
    this._saveSettings();
  },

  _moveThreshold() {
    return moveThreshold(this.sensitivity);
  },

  openPause() {
    if (this.phase !== 'grid') {
      return;
    }
    this.phase = 'pause';
  },

  closePause() {
    if (this.phase !== 'pause') {
      return;
    }
    this.phase = 'grid';
    this._renderMap();
    this._saveRun();
  },

  endRun() {
    this._clearSave();
    this.phase = 'home';
  },

  _rollShopItems() {
    var arr = SHOP_ITEMS.slice();
    var out = [];
    for (var i = 0; i < arr.length && out.length < 6; i++) {
      var idx = Math.floor(Math.random() * arr.length);
      var it = Object.assign({}, arr.splice(idx, 1)[0]);
      if (Math.random() < 0.2) {
        it.price = Math.round(it.price * 0.8);
        it.discount = true;
      }
      if (this._haggle > 0) {
        it.price = Math.round(it.price * (1 - this._haggle));
        it.haggle = true;
      }
      out.push(it);
    }
    this.shopItems = out;
  },

  openShop() {
    if (this.phase !== 'grid') {
      return;
    }
    this.phase = 'shop';
    this._rollShopItems();
    this._updateUpgradeCosts();
  },

  refreshShop() {
    if (this.phase !== 'shop' || this.gold < 5) {
      return;
    }
    this.gold -= 5;
    this._rollShopItems();
    this._addLog('商店已刷新（-5金）');
  },

  _equipRolled(weapon) {
    if (weapon) {
      if (weapon.atk > this.weaponAtk) {
        this.weaponAtk = weapon.atk;
        this.weaponName = weapon.name;
        this.atk = this.baseAtk + this.weaponAtk;
        this.skillName = this._skillName();
        this._addLog('获得武器 ' + weapon.name + '，攻击 +' + weapon.atk);
        return true;
      }
      this._addLog('获得 ' + weapon.name + '，但不如当前武器');
      return false;
    }
    return false;
  },

  _equipRolledArmor(armor) {
    if (armor) {
      if (armor.def > this.armorDef) {
        this.armorDef = armor.def;
        this.armorName = armor.name;
        this.dodge = armor.dodge || 0;
        this._addLog('获得防具 ' + armor.name + '，防御 +' + armor.def);
        return true;
      }
      this._addLog('获得 ' + armor.name + '，但不如当前防具');
      return false;
    }
    return false;
  },

  craftItem() {
    var craftCost = Math.round(20 * (1 - this._craftDiscount));
    if (this.phase !== 'shop' || this.materials < 3 || this.gold < craftCost) {
      return;
    }
    this.materials -= 3;
    this.gold -= craftCost;
    if (Math.random() < 0.5) {
      this._equipRolled(this._rollWeapon());
    } else {
      this._equipRolledArmor(this._rollArmor());
    }
    this._updateUpgradeCosts();
  },

  sellMaterials() {
    if (this.phase !== 'shop' || this.materials <= 0) {
      return;
    }
    var gain = this.materials * 8;
    this.gold += gain;
    this.materials = 0;
    this._addLog('出售材料，获得 ' + gain + ' 金币');
    this._updateUpgradeCosts();
  },

  gambleEquip() {
    var gambleCost = Math.round(40 * (1 - this._craftDiscount));
    if (this.phase !== 'shop' || this.gold < gambleCost) {
      return;
    }
    this.gold -= gambleCost;
    // 保底高品质：直接取最高两档品质
    var weapon = this._rollWeapon();
    var armor = this._rollArmor();
    if (Math.random() < 0.5) {
      this._equipRolled(weapon);
    } else {
      this._equipRolledArmor(armor);
    }
    this._updateUpgradeCosts();
  },

  _recordEquip(baseName) {
    if (!baseName) {
      return;
    }
    if (this.equipCodex.indexOf(baseName) < 0) {
      this.equipCodex.push(baseName);
      this._saveMeta();
      if (this.equipCodex.length >= this.equipTotal && this.equipTotal > 0) {
        this._unlockAchievement('equip_master');
      }
    }
  },

  _recordBest() {
    if (this.weaponAtk > this.bestWeaponAtk) {
      this.bestWeaponAtk = this.weaponAtk;
      this._saveMeta();
    }
    if (this.armorDef > this.bestArmorDef) {
      this.bestArmorDef = this.armorDef;
      this._saveMeta();
    }
  },

  _updateUpgradeCosts() {
    this.weaponUpgradeCost = 30 + this.weaponAtk * 10;
    this.armorUpgradeCost = 30 + this.armorDef * 10;
  },

  upgradeWeapon() {
    if (this.phase !== 'shop' || this.gold < this.weaponUpgradeCost) {
      return;
    }
    this.gold -= this.weaponUpgradeCost;
    this.weaponAtk += 2 + this._forgeBonus;
    this.atk = this.baseAtk + this.weaponAtk;
    this.skillName = this._skillName();
    this.weaponName = this.weaponName.replace(/\([^)]*\)?$/, '') + '(强化)';
    this._addLog('强化武器至 +' + this.weaponAtk);
    this._updateUpgradeCosts();
  },

  upgradeArmor() {
    if (this.phase !== 'shop' || this.gold < this.armorUpgradeCost) {
      return;
    }
    this.gold -= this.armorUpgradeCost;
    this.armorDef += 2 + this._forgeBonus;
    this.armorName = this.armorName.replace(/\([^)]*\)?$/, '') + '(强化)';
    this._addLog('强化防具至 +' + this.armorDef);
    this._updateUpgradeCosts();
  },

  closeShop() {
    this.phase = 'grid';
    this._renderMap();
    this._saveRun();
  },

  buyItem(id) {
    var item = null;
    for (var i = 0; i < this.shopItems.length; i++) {
      if (this.shopItems[i].id === id) {
        item = this.shopItems[i];
        break;
      }
    }
    if (!item) {
      return;
    }
    if (this.gold < item.price) {
      this._addLog('金币不足');
      return;
    }
    if (item.type === 'potion') {
      this.gold -= item.price;
      this.potions += 1;
      this._addLog('购买药水，剩余药水 ' + this.potions);
    } else if (item.type === 'weapon') {
      var weapon = null;
      for (var j = 0; j < WEAPONS.length; j++) {
        if (WEAPONS[j].name === item.name) {
          weapon = WEAPONS[j];
          break;
        }
      }
      if (weapon && weapon.atk > this.weaponAtk) {
        this.gold -= item.price;
        this.weaponAtk = weapon.atk;
        this.weaponName = weapon.name;
        this.atk = this.baseAtk + this.weaponAtk;
        this.skillName = this._skillName();
        this._addLog('购买武器 ' + weapon.name + '，攻击 +' + weapon.atk);
      } else {
        this._addLog('你已经拥有更好的武器');
      }
    } else if (item.type === 'armor') {
      var armor = null;
      for (var k = 0; k < ARMORS.length; k++) {
        if (ARMORS[k].name === item.name) {
          armor = ARMORS[k];
          break;
        }
      }
      if (armor && armor.def > this.armorDef) {
        this.gold -= item.price;
        this.armorDef = armor.def;
        this.armorName = armor.name;
        this._addLog('购买防具 ' + armor.name + '，防御 +' + armor.def);
      } else {
        this._addLog('你已经拥有更好的防具');
      }
    }
  },

  openBag() {
    if (this.phase !== 'grid') {
      return;
    }
    this.phase = 'bag';
  },

  closeBag() {
    this.phase = 'grid';
    this._renderMap();
    this._saveRun();
  },

  usePotionFromBag() {
    if (this.phase !== 'bag' || this.potions <= 0 || this.hp >= this.maxHp) {
      return;
    }
    if (this.challengeMode) {
      this._addLog('挑战模式：无法使用药水');
      return;
    }
    this.potions -= 1;
    var healAmt = this._healAmount();
    this.hp = Math.min(this.maxHp, this.hp + healAmt);
    if (this._potionShield > 0) {
      this._shield += this._potionShield;
    }
    if (this._potionCombo > 0) {
      this.combo += this._potionCombo;
    }
    this._updateHp();
    this._addLog('使用药水，回复 ' + healAmt + ' 生命' + (this._potionShield > 0 ? '，获得护盾' : ''));
  }
};
</script>

<style>
.page {
  width: 100%;
  height: 100%;
  background-color: #0d0d0f;
  position: relative;
}

.home-content {
  width: 192px;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: 30px;
}

.h-title {
  color: #f5f5f7;
  font-size: 24px;
  font-weight: bold;
  margin-top: 20px;
}

.h-sub {
  color: #5a6a9a;
  font-size: 12px;
  margin-top: 4px;
}

.h-label {
  color: #4a5a7a;
  font-size: 11px;
